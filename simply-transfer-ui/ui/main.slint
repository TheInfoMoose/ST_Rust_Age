import { Button, VerticalBox, HorizontalBox, TabWidget, ListView, LineEdit, GroupBox, ProgressIndicator, CheckBox, ComboBox, Palette } from "std-widgets.slint";

export struct TransferQueueItem {
    name: string,
    size: string,
    progress: float,
}

export struct CompletedItem {
    name: string,
    status: string,
    status_color: color,
}

export struct DirectoryMapping {
    source: string,
    destination: string,
}

export struct FileNode {
    name: string,
    is_dir: bool,
    path: string,
}

export struct ConnectionItem {
    name: string,
    host: string,
    state: string,
    state_color: color,
    transfer_rate: string,
    duration: string,
    eta: string,
    transfer_type: string,
    token: string,
}

export global AppTheme {
    in-out property <bool> force_light: false;
    out property <color> accent: force_light ? #CB693F : #b94616;
    out property <color> accent_hover: force_light ? #e07b50 : #c95b28;
    out property <color> accent_pressed: force_light ? #b0552b : #943812;
    out property <color> border: force_light ? #E0E0E0 : #333333;
    out property <color> list_hover: force_light ? #E0E0E0 : #333333;
    out property <color> window_bg: force_light ? #F5F5F5 : Palette.background;
}

component StyledBox inherits Rectangle {
    border-width: 1px;
    border-color: AppTheme.border;
    border-radius: 6px;
}

component RustRadioButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked: false;
    callback clicked();
    height: 20px;

    HorizontalBox {
        spacing: 8px;
        padding: 0;
        alignment: start;

        Rectangle {
            width: 18px;
            height: 18px;
            border-width: 2px;
            border-radius: 9px;
            border-color: root.checked ? AppTheme.accent : gray;
            background: transparent;
            
            if root.checked: Rectangle {
                width: 10px; height: 10px;
                x: 4px; y: 4px;
                border-radius: 5px;
                background: AppTheme.accent;
            }
        }
        Text { 
            text: root.text; 
            vertical-alignment: center; 
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component RustButton inherits Rectangle {
    in property <string> text;
    callback clicked <=> touch.clicked;
    
    background: touch.pressed ? AppTheme.accent_pressed : (touch.has-hover ? AppTheme.accent_hover : AppTheme.accent);
    border-radius: 4px;
    height: 30px;
    min-width: max(100px, txt.preferred-width + 24px);

    txt := Text {
        text: root.text;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 500;
    }
    touch := TouchArea {}
}

component RustCheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    callback toggled(bool);
    height: 20px;

    HorizontalBox {
        spacing: 8px;
        padding: 0;
        alignment: start;

        Rectangle {
            width: 18px;
            height: 18px;
            border-width: 2px;
            border-radius: 3px;
            border-color: root.checked ? AppTheme.accent : gray;
            background: root.checked ? AppTheme.accent : transparent;
            
            if root.checked: Path {
                viewbox-width: 14; viewbox-height: 14;
                stroke: white; stroke-width: 2px;
                MoveTo { x: 3; y: 7; }
                LineTo { x: 6; y: 10; }
                LineTo { x: 11; y: 4; }
            }
        }
        Text { 
            text: root.text; 
            vertical-alignment: center; 
        }
    }
    touch := TouchArea {
        clicked => { 
            root.checked = !root.checked; 
            root.toggled(root.checked);
        }
    }
}

export component TransferQueueRow inherits Rectangle {
    in property <TransferQueueItem> file;
    height: 25px;
    HorizontalBox {
        padding: 0; spacing: 10px;
        Rectangle { width: 50%; Text { text: root.file.name; overflow: elide; } }
        Rectangle { width: 20%; Text { text: root.file.size; horizontal-alignment: right; } }
        Rectangle { width: 30%; ProgressIndicator { progress: root.file.progress; width: 100%; } }
    }
}

export component CompletedQueueRow inherits Rectangle {
    in property <CompletedItem> file;
    height: 25px;
    HorizontalBox {
        padding: 0; spacing: 10px;
        Rectangle { width: 60%; Text { text: root.file.name; overflow: elide; } }
        Rectangle { width: 40%; Text { text: root.file.status; color: root.file.status_color; horizontal-alignment: right; } }
    }
}

export component MetricsGrid inherits Rectangle {
    in property <string> upload_speed: "0 MB/s";
    in property <string> download_speed: "0 MB/s";
    in property <string> eta: "0s";

    HorizontalBox {
        padding: 0; spacing: 0;
        Rectangle { width: 33%; Text { text: "Upload: " + root.upload_speed; horizontal-alignment: left; } }
        Rectangle { width: 33%; Text { text: "Download: " + root.download_speed; horizontal-alignment: center; } }
        Rectangle { width: 34%; Text { text: "ETA: " + root.eta; horizontal-alignment: right; } }
    }
}

export component SessionPopout inherits Window {
    title: "Session Monitor";
    width: 600px;
    height: 400px;

    in property <[TransferQueueItem]> transfer_queue;
    in property <string> phase_text: "Live Transfer Queue";

    VerticalBox {
        Text { text: root.phase_text; font-weight: 700; font-size: 16px; }
        ListView {
            for file in root.transfer_queue : HorizontalBox {
                Text { text: file.name; }
                Text { text: file.size; }
                ProgressIndicator { progress: file.progress; }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Simply Transfer v2";
    width: 1000px;
    height: 750px;
    background: AppTheme.window_bg;

    // Callbacks for Rust backend
    callback start_transfer();
    callback add_connection();
    callback commit_connection(ConnectionItem);
    callback delete_connection(int);
    callback verify_remote_token(string);
    callback copy_token();
    callback open_log_file(string);
    callback generate_key(string) -> string;
    callback remove_key();
    callback pause_transfer();
    callback cancel_transfer();
    callback popout_session();
    callback cancel_key_generation(string);
    callback purge_orphaned_keys() -> int;
    
    // File browsing callbacks
    callback browse_source(int);
    callback browse_destination(int);
    callback add_mapping();
    callback remove_mapping(int);
    callback update_mapping_source(int, string);
    callback update_mapping_destination(int, string);
    
    // Remote browser callbacks
    callback fetch_directory(string, bool); // path, is_remote
    callback commit_browser_selection(string); // path
    
    // System Info States
    in property <string> os_processor_info: "Processor: Unknown";
    in property <string> os_memory_info: "RAM: Unknown";
    // Properties updated by backend
    in property <int> active_tab: 0;
    in property <[TransferQueueItem]> transfer_queue: [];
    in property <[CompletedItem]> completed_queue: [];
    in property <string> overall_status: "Completed: 0 / 0 files";
    in property <string> phase_text: "Live Transfer Queue";
    
    // Browser States
    in-out property <bool> is_browser_open: false;
    in-out property <bool> browser_is_remote: false;
    in-out property <int> browser_target_idx: 0;
    in-out property <string> browser_current_path: "/";
    in-out property <[FileNode]> browser_nodes: [];
    in-out property <string> browser_selection: "";
    in-out property <bool> browser_is_source: false;
    
    // Dashboard States
    in-out property <[ConnectionItem]> connections: [];
    in-out property <int> selected_connection_idx: 0;
    property <bool> is_editing_connection: false;
    property <bool> is_adding_connection: false;
    property <int> add_connection_tab: 0;
    in-out property <bool> is_remote_verified: false;
    in-out property <string> remote_verification_status: "";
    in-out property <string> remote_verified_host: "";

    in property <string> network_link_type: "Dynamic";
    in property <string> network_max_throughput: "Variable";


    // Transfer Setup States
    in-out property <string> transfer_type_val: "Single Transfer";
    in-out property <[DirectoryMapping]> current_mappings: [{source: "", destination: ""}];

    // Active Transfers States
    in property <[string]> active_sessions: [];
    in-out property <int> selected_session_idx: 0;
    in-out property <string> metric_upload: "0.0 MB/s";
    in-out property <string> metric_download: "0.0 MB/s";
    in-out property <string> metric_eta: "0s";
    in-out property <string> current_phase: "Idle";
    in-out property <bool> is_transfer_paused: false;
    property <int> tick: 0;
    property <string> ellipsis: root.tick == 0 ? "" : (root.tick == 1 ? "." : (root.tick == 2 ? ".." : "..."));
    
    Timer {
        interval: 500ms;
        running: root.current_phase != "Idle" && root.current_phase != "Transfer Complete" && root.current_phase != "";
        triggered => {
            root.tick = Math.mod(root.tick + 1, 4);
        }
    }

    // Settings States
    property <int> selected_setting_idx: 0;
    property <string> current_theme: "Match System";

    changed current_theme => {
        AppTheme.force_light = (root.current_theme == "Light");
        if (root.current_theme == "Dark") {
            Palette.color-scheme = ColorScheme.dark;
        } else if (root.current_theme == "Light") {
            Palette.color-scheme = ColorScheme.light;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }

    TabWidget {
        current-index: root.active_tab;

        Tab {
            title: "Dashboard";
            HorizontalBox {
                // Left Column: Active Connections
                StyledBox {
                    width: 300px;
                    VerticalBox {
                        padding-top: 15px; padding-bottom: 15px; padding-left: 0px; padding-right: 0px;
                        HorizontalBox {
                            padding-left: 16px; padding-bottom: 8px;
                            Text { text: "Active Connections"; font-weight: 800; font-size: 16px; }
                        }
                        ListView {
                            for item[idx] in root.connections : Rectangle {
                                height: 40px;
                                background: root.selected_connection_idx == idx ? AppTheme.accent : (touch.has-hover ? AppTheme.list_hover : transparent);
                                touch := TouchArea { clicked => { root.selected_connection_idx = idx; root.is_editing_connection = false; root.is_adding_connection = false; } }
                                HorizontalBox {
                                    padding-left: 16px; padding-right: 16px;
                                    Text { text: item.name; vertical-alignment: center; horizontal-alignment: left; width: 110px; font-weight: 700; overflow: elide; }
                                    Text { text: item.state; color: item.state_color; vertical-alignment: center; horizontal-alignment: center; horizontal-stretch: 1; font-weight: 700; }
                                    Text { text: item.transfer_rate; vertical-alignment: center; horizontal-alignment: right; width: 60px; font-weight: 700; }
                                }
                            }
                        }
                        Rectangle { height: 10px; }
                        HorizontalBox {
                            padding-left: 16px; padding-right: 16px;
                            RustButton {
                                text: "+";
                                clicked => { 
                                    root.is_adding_connection = true; 
                                    root.is_editing_connection = false;
                                }
                            }
                        }
                    }
                }

                // Right Column: Connection Details
                StyledBox {
                    horizontal-stretch: 1;
                    VerticalBox {
                        padding: 15px;
                    if !root.is_adding_connection && !root.is_editing_connection && root.connections.length > 0: HorizontalBox {
                        alignment: end;
                        Button {
                            text: "-";
                            clicked => { 
                                root.delete_connection(root.selected_connection_idx); 
                            }
                        }
                    }

                    if !root.is_adding_connection && !root.is_editing_connection && root.connections.length > 0: VerticalBox {
                        Text { text: "Connection Details"; font-weight: 700; font-size: 18px; }
                        Rectangle { height: 10px; }
                        spacing: 8px;
                        Text { text: "Name: " + root.connections[root.selected_connection_idx].name; }
                        Text { text: "Host: " + root.connections[root.selected_connection_idx].host; }
                        HorizontalBox { 
                            padding: 0; spacing: 0;
                            Text { text: "State: "; } 
                            Text { text: root.connections[root.selected_connection_idx].state; color: root.connections[root.selected_connection_idx].state_color; }
                        }
                        Text { text: "Transfer Rate: " + root.connections[root.selected_connection_idx].transfer_rate; }
                        Text { text: "Duration: " + root.connections[root.selected_connection_idx].duration; }
                        Text { text: "Estimated Completion: " + root.connections[root.selected_connection_idx].eta; }
                        Text { text: "Type of Transfer: " + root.connections[root.selected_connection_idx].transfer_type; }
                        


                        Rectangle { vertical-stretch: 1; }

                        HorizontalBox {
                            Text { text: "Destination Token:"; vertical-alignment: center; }
                            LineEdit { text: root.connections[root.selected_connection_idx].token; read-only: true; }
                            Button { text: "Copy"; clicked => { root.copy_token(); } }
                        }
                        Button { 
                            text: "Edit Connection"; 
                            clicked => { root.is_editing_connection = true; } 
                        }
                    }

                    if root.is_editing_connection && root.connections.length > 0: VerticalBox {
                        HorizontalBox {
                            alignment: end;
                            Button {
                                text: "-";
                                clicked => { 
                                    root.delete_connection(root.selected_connection_idx); 
                                    root.is_editing_connection = false;
                                }
                            }
                        }
                        Text { text: "Edit Connection"; font-weight: 700; font-size: 18px; }
                        Rectangle { height: 10px; }
                        spacing: 8px;
                        HorizontalBox { Text { text: "Name:"; width: 100px; vertical-alignment: center; } edit_name := LineEdit { text: root.connections[root.selected_connection_idx].name; } }
                        HorizontalBox { Text { text: "Host:"; width: 100px; vertical-alignment: center; } edit_host := LineEdit { text: root.connections[root.selected_connection_idx].host; } }
                        HorizontalBox { 
                            Text { text: "Key:"; width: 100px; vertical-alignment: center; } 
                            edit_key := LineEdit { text: root.connections[root.selected_connection_idx].token; }
                            Button { text: "Generate"; clicked => { edit_key.text = root.generate_key(edit_host.text); } }
                            Button { text: "Remove"; clicked => { edit_key.text = ""; root.remove_key(); } }
                        }
                        
                        Rectangle { vertical-stretch: 1; }

                        HorizontalBox {
                            alignment: end;
                            spacing: 10px;
                            Button { text: "Cancel"; clicked => { root.is_editing_connection = false; } }
                            RustButton { 
                                text: "Commit"; 
                                clicked => { 
                                    root.is_editing_connection = false; 
                                } 
                            }
                        }
                    }

                    if root.is_adding_connection: VerticalBox {
                        HorizontalBox {
                            alignment: space-between;
                            HorizontalBox {
                                alignment: start;
                                spacing: 0px;
                                Rectangle {
                                    width: 80px; height: 30px;
                                    background: root.add_connection_tab == 0 ? AppTheme.list_hover : transparent;
                                    Text { text: "New"; horizontal-alignment: center; vertical-alignment: center; font-weight: root.add_connection_tab == 0 ? 700 : 500; }
                                    TouchArea { clicked => { root.add_connection_tab = 0; } }
                                }
                                Rectangle {
                                    width: 80px; height: 30px;
                                    background: root.add_connection_tab == 1 ? AppTheme.list_hover : transparent;
                                    Text { text: "Remote"; horizontal-alignment: center; vertical-alignment: center; font-weight: root.add_connection_tab == 1 ? 700 : 500; }
                                    TouchArea { clicked => { root.add_connection_tab = 1; } }
                                }
                            }
                            Text { text: "Add Connection"; font-weight: 700; font-size: 18px; vertical-alignment: center; }
                        }
                        Rectangle { height: 20px; }

                        if root.add_connection_tab == 0: VerticalBox {
                            Text { text: "New Connection"; font-weight: 700; font-size: 16px; }
                            Rectangle { height: 10px; }
                            spacing: 8px;
                            HorizontalBox { Text { text: "Name:"; width: 100px; vertical-alignment: center; } new_name := LineEdit { placeholder-text: "Connection Name"; } }
                            HorizontalBox { Text { text: "Host:"; width: 100px; vertical-alignment: center; } new_host := LineEdit { placeholder-text: "e.g. user@IP or IP"; } }
                            HorizontalBox { 
                                Text { text: "Key:"; width: 100px; vertical-alignment: center; } 
                                new_key := LineEdit { placeholder-text: "Click Generate to create token"; }
                                Button { text: "Generate"; clicked => { new_key.text = root.generate_key(new_host.text); } }
                            }
                            Rectangle { vertical-stretch: 1; }
                            HorizontalBox {
                                alignment: end;
                                spacing: 10px;
                                Button { text: "Cancel"; clicked => { root.is_adding_connection = false; root.cancel_key_generation(new_key.text); } }
                                RustButton { 
                                    text: "Commit"; 
                                    clicked => { 
                                        root.is_adding_connection = false; 
                                        root.commit_connection({ name: new_name.text, host: new_host.text, state: "Idle", state_color: Colors.gray, transfer_rate: "-", duration: "-", eta: "-", transfer_type: "Single Transfer", token: new_key.text }); 
                                    } 
                                }
                            }
                        }

                        if root.add_connection_tab == 1: VerticalBox {
                            Text { text: "Remote Connection"; font-weight: 700; font-size: 16px; }
                            Rectangle { height: 10px; }
                            spacing: 8px;
                            HorizontalBox { 
                                Text { text: "Token:"; width: 100px; vertical-alignment: center; } 
                                remote_token := LineEdit { placeholder-text: "Paste Remote Token Here"; }
                                Button { 
                                    text: "Verify"; 
                                    clicked => { 
                                        root.remote_verification_status = "Verifying...";
                                        root.verify_remote_token(remote_token.text); 
                                    } 
                                }
                            }
                            if root.remote_verification_status != "": Text {
                                text: "Status: " + root.remote_verification_status;
                                color: root.is_remote_verified ? AppTheme.accent : gray;
                            }
                            Rectangle { vertical-stretch: 1; }
                            HorizontalBox {
                                alignment: end;
                                spacing: 10px;
                                Button { text: "Cancel"; clicked => { 
                                    root.is_adding_connection = false; 
                                    root.is_remote_verified = false;
                                    root.remote_verification_status = "";
                                } }
                                Rectangle {
                                    width: max(100px, btn_txt.preferred-width + 24px);
                                    height: 30px;
                                    border-radius: 4px;
                                    background: root.is_remote_verified ? AppTheme.accent : gray;
                                    btn_txt := Text { text: "Commit"; color: white; horizontal-alignment: center; vertical-alignment: center; font-weight: 500; }
                                    TouchArea {
                                        clicked => {
                                            if root.is_remote_verified {
                                                root.is_adding_connection = false;
                                                let host_str = root.remote_verified_host != "" ? root.remote_verified_host : "Remote";
                                                root.commit_connection({ name: "Remote", host: host_str, state: "Idle", state_color: Colors.gray, transfer_rate: "-", duration: "-", eta: "-", transfer_type: "Remote Transfer", token: remote_token.text });
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }
        }

        Tab {
            title: "Transfer";
            VerticalBox {
                TabWidget {
                    Tab {
                        title: "Transfer Setup";
                        StyledBox {
                            VerticalBox {
                                padding: 15px;
                            spacing: 12px;
                            for mapping[idx] in root.current_mappings : HorizontalBox {
                                Text { text: "Source Path:"; vertical-alignment: center; }
                                LineEdit { text: mapping.source; placeholder-text: "/path/to/source"; edited(text) => { root.update_mapping_source(idx, text); } }
                                Button { text: "Browse"; clicked => { root.browse_source(idx); } }

                                Rectangle { width: 20px; }

                                Text { text: "Destination Path:"; vertical-alignment: center; }
                                LineEdit { text: mapping.destination; placeholder-text: "/path/to/destination"; edited(text) => { root.update_mapping_destination(idx, text); } }
                                Button { text: "Browse"; clicked => { root.browse_destination(idx); } }
                                
                                if root.current_mappings.length > 1: Button { text: "-"; clicked => { root.remove_mapping(idx); } }
                            }
                            Button { text: "+ Add Row"; clicked => { root.add_mapping(); } }

                            Rectangle { height: 1px; background: gray; }

                            HorizontalBox {
                                Text { text: "Transfer Type:"; vertical-alignment: center; width: 120px; }
                                ComboBox {
                                    model: ["Single Transfer", "Continuous Sync", "Scheduled Transfer"];
                                    current-value: root.transfer_type_val;
                                    selected(val) => { root.transfer_type_val = val; }
                                }
                            }
                            
                            if root.transfer_type_val == "Continuous Sync": HorizontalBox {
                                Text { text: "Sync Frequency:"; vertical-alignment: center; width: 120px; }
                                ComboBox {
                                    model: ["1min", "5min", "15min", "30min", "1hr", "2hr", "4hr", "6hr", "8hr", "12hr", "24hr", "48hr", "72hr"];
                                    current-value: "1hr";
                                }
                            }

                            if root.transfer_type_val == "Scheduled Transfer": VerticalBox {
                                spacing: 8px;
                                HorizontalBox {
                                    Text { text: "Active Days:"; vertical-alignment: center; width: 120px; }
                                    RustCheckBox { text: "M"; } RustCheckBox { text: "T"; } RustCheckBox { text: "W"; } RustCheckBox { text: "Th"; } RustCheckBox { text: "F"; } RustCheckBox { text: "Sa"; } RustCheckBox { text: "Su"; }
                                }
                                HorizontalBox {
                                    Text { text: "Start Permitted:"; vertical-alignment: center; width: 120px; }
                                    ComboBox { model: ["00:00", "01:00", "02:00", "08:00", "12:00", "18:00", "22:00"]; }
                                    Rectangle { width: 20px; }
                                    Text { text: "Finish Permitted:"; vertical-alignment: center; }
                                    ComboBox { model: ["00:00", "06:00", "08:00", "12:00", "18:00", "23:59"]; }
                                }
                            }

                            Rectangle { vertical-stretch: 1; }

                            HorizontalBox {
                                alignment: end;
                                Button { text: "Commit"; }
                                RustButton { 
                                    text: "Commit & Start"; 
                                    clicked => { root.start_transfer(); }
                                }
                            }
                        }
                        }
                    }
                    Tab {
                        title: "Active Transfers";
                        HorizontalBox {
                            // Left list
                            StyledBox {
                                width: 250px;
                                VerticalBox {
                                    padding-top: 15px; padding-bottom: 15px; padding-left: 0px; padding-right: 0px;
                                    HorizontalBox {
                                        padding-left: 16px; padding-bottom: 8px;
                                        Text { text: "Active Sessions"; font-weight: 800; font-size: 16px; }
                                    }
                                    ListView {
                                        for session[idx] in root.active_sessions : Rectangle {
                                            height: 30px;
                                            background: root.selected_session_idx == idx ? AppTheme.accent : (ta.has-hover ? AppTheme.list_hover : transparent);
                                            ta := TouchArea { clicked => { root.selected_session_idx = idx; } }
                                            HorizontalBox {
                                                padding-left: 16px; padding-right: 16px;
                                                Text { text: session; vertical-alignment: center; font-weight: 700; }
                                            }
                                        }
                                    }
                                }
                            }
                            // Right details
                            StyledBox {
                                horizontal-stretch: 1;
                                VerticalBox {
                                    padding: 15px;
                                HorizontalBox {
                                    alignment: end;
                                    Button { text: "↗"; clicked => { root.popout_session(); } }
                                }
                                Text { text: root.phase_text; font-weight: 700; }
                                ListView {
                                    height: 150px;
                                    for file in root.transfer_queue : TransferQueueRow {
                                        file: file;
                                    }
                                }
                                HorizontalBox {
                                    padding: 0; spacing: 0;
                                    MetricsGrid {
                                        upload_speed: root.metric_upload;
                                        download_speed: root.metric_download;
                                        eta: root.metric_eta;
                                        horizontal-stretch: 1;
                                    }
                                    Text { text: root.current_phase; }
                                    Text { text: root.ellipsis; width: 15px; horizontal-alignment: left; }
                                }
                                
                                Rectangle { height: 10px; }
                                Rectangle { height: 1px; background: gray; }
                                Rectangle { height: 10px; }

                                Text { text: "Integrity Validation"; font-weight: 700; }
                                ListView {
                                    height: 150px;
                                    for file in root.completed_queue : CompletedQueueRow {
                                        file: file;
                                    }
                                }
                                Text { text: root.overall_status; }

                                HorizontalBox {
                                    Button {
                                        text: root.is_transfer_paused ? "Resume Transfer" : "Pause Transfer";
                                        clicked => {
                                            root.is_transfer_paused = !root.is_transfer_paused;
                                            root.pause_transfer();
                                        }
                                    }
                                    Button { text: "Cancel Transfer"; clicked => { root.cancel_transfer(); } }
                                }
                            }
                        }
                        }
                    }
                }
            }
        }

        Tab {
            title: "Settings";
            HorizontalBox {
                // Left Column
                StyledBox {
                    width: 250px;
                    VerticalBox {
                        padding-top: 15px; padding-bottom: 15px; padding-left: 0px; padding-right: 0px;
                        ListView {
                            for setting[idx] in ["Display", "Transfer Settings", "Notifications", "Import/Export", "Help", "Logs"] : Rectangle {
                                height: 40px;
                                background: root.selected_setting_idx == idx ? AppTheme.accent : (sta.has-hover ? AppTheme.list_hover : transparent);
                                sta := TouchArea { clicked => { root.selected_setting_idx = idx; } }
                                HorizontalBox {
                                    padding-left: 16px; padding-right: 16px;
                                    Text { text: setting; vertical-alignment: center; font-weight: 700; }
                                }
                            }
                        }
                    }
                }

                // Right Column
                StyledBox {
                    horizontal-stretch: 1;
                    VerticalBox {
                        padding: 15px;
                        padding-left: 20px;
                    
                    if root.selected_setting_idx == 5: VerticalBox {
                        Text { text: "Application Logs"; font-size: 20px; font-weight: 700; }
                        Rectangle { height: 10px; }
                        
                        Text { text: "Connection Logs:"; font-weight: 700; }
                        Text { text: "Validation and Authentication events"; font-size: 11px; color: gray; }
                        Button { text: "Open Connection Logs"; clicked => { root.open_log_file("connection.log"); } }
                        Rectangle { height: 10px; }
                        
                        Text { text: "Transfers Logs:"; font-weight: 700; }
                        Text { text: "Transmission and Validation events"; font-size: 11px; color: gray; }
                        Button { text: "Open Transfer Logs"; clicked => { root.open_log_file("transfers.log"); } }
                        Rectangle { height: 10px; }
                        
                        Text { text: "Sync Logs:"; font-weight: 700; }
                        Text { text: "Active Sync engine events"; font-size: 11px; color: gray; }
                        Button { text: "Open Sync Logs"; clicked => { root.open_log_file("sync.log"); } }
                        Rectangle { height: 10px; }
                        
                        Text { text: "Schedule Logs:"; font-weight: 700; }
                        Text { text: "Validation of scheduled transfers running"; font-size: 11px; color: gray; }
                        Button { text: "Open Schedule Logs"; clicked => { root.open_log_file("schedule.log"); } }
                        
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.selected_setting_idx == 0: VerticalBox {
                        Text { text: "Display Settings"; font-size: 20px; font-weight: 700; }
                        Rectangle { height: 20px; }
                        
                        HorizontalBox {
                            spacing: 20px;
                            VerticalBox {
                                Image { source: @image-url("../../assets/theme_dark.png"); width: 200px; height: 120px; }
                                RustRadioButton { 
                                    text: "Dark Mode"; 
                                    checked: root.current_theme == "Dark"; 
                                    clicked => { root.current_theme = "Dark"; } 
                                }
                            }
                            VerticalBox {
                                Image { source: @image-url("../../assets/theme_light.png"); width: 200px; height: 120px; }
                                RustRadioButton { 
                                    text: "Light Mode"; 
                                    checked: root.current_theme == "Light"; 
                                    clicked => { root.current_theme = "Light"; } 
                                }
                            }
                            VerticalBox {
                                Image { source: @image-url("../../assets/theme_system.png"); width: 200px; height: 120px; }
                                RustRadioButton { 
                                    text: "Match System"; 
                                    checked: root.current_theme == "Match System"; 
                                    clicked => { root.current_theme = "Match System"; } 
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.selected_setting_idx == 1: VerticalBox {
                        Text { text: "Transfer Settings"; font-size: 20px; font-weight: 700; }
                        Rectangle { height: 20px; }
                        
                        Text { text: "Bandwidth Allocation (MB/s):"; font-weight: 700; }
                        Text { text: "Connection: " + root.network_link_type + " | Max Throughput: " + root.network_max_throughput; font-size: 11px; color: gray; }
                        Rectangle { height: 5px; }
                        LineEdit { text: "0 (Unlimited)"; }
                        
                        Rectangle { height: 20px; }
                        
                        Text { text: "Max Threads:"; font-weight: 700; }
                        Text { text: root.os_processor_info; font-size: 11px; color: gray; }
                        Rectangle { height: 5px; }
                        LineEdit { text: "16"; }

                        Rectangle { height: 20px; }
                        
                        Text { text: "Credential Management:"; font-weight: 700; }
                        Rectangle { height: 5px; }
                        RustButton {
                            text: "Purge Orphaned Keys";
                            clicked => { root.purge_orphaned_keys(); }
                        }

                        Rectangle { height: 20px; }
                        Text { text: "Max Memory (MB):"; font-weight: 700; }
                        Text { text: root.os_memory_info + " | Minimum Required: 512 MB"; font-size: 11px; color: gray; }
                        Rectangle { height: 5px; }
                        LineEdit { text: "4096"; }

                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.selected_setting_idx == 2: VerticalBox {
                        Text { text: "Notifications"; font-size: 20px; font-weight: 700; }
                        Rectangle { height: 20px; }
                        
                        HorizontalBox {
                            Text { text: "Notification Type:"; vertical-alignment: center; }
                            ComboBox { model: ["OS Pop-up", "Email", "None"]; }
                        }
                        
                        RustCheckBox { text: "Notify on transfer completion"; checked: true; }
                        RustCheckBox { text: "Notify on validation failure"; checked: true; }
                        
                        Rectangle { height: 10px; }
                        Button { text: "Request OS Permissions"; }
                        Rectangle { height: 5px; }
                        Text { text: "Note: If permissions are denied by the OS, notifications will safely fall back to None."; font-size: 11px; color: gray; }

                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.selected_setting_idx == 3: VerticalBox {
                        Text { text: "Import/Export Profiles"; font-size: 20px; font-weight: 700; }
                        Rectangle { height: 20px; }
                        
                        HorizontalBox {
                            Button { text: "Import Profile (.json)"; }
                            Button { text: "Export Profile (.json)"; }
                        }
                        
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.selected_setting_idx == 4: VerticalBox {
                        Text { text: "Help & Support"; font-size: 20px; font-weight: 700; }
                        Rectangle { height: 20px; }
                        
                        Text { text: "Github Repository:"; font-weight: 700; }
                        Text { text: "https://github.com/TheInfoMoose/ST_Rust_Age.git"; color: AppTheme.accent; }
                        
                        Rectangle { height: 20px; }
                        
                        Text { text: "Troubleshooting:"; font-weight: 700; }
                        Text { text: "• If connections fail, verify firewall rules for SSH (port 22).\n• Ensure destination tokens are copied completely.\n• OOM crashes are prevented via stream buffering."; wrap: word-wrap; }
                        
                        Rectangle { height: 20px; }

                        Text { text: "FAQs:"; font-weight: 700; }
                        Text { text: "Q: Can I transfer active databases?\nA: Yes, Windows VSS and Linux LVM snapshots automatically handle locked files."; wrap: word-wrap; }

                        Rectangle { vertical-stretch: 1; }
                    }
                    }
                }
            }
        }
    } // End of TabWidget
        
        // File Browser Modal Overlay
        if root.is_browser_open: Rectangle {
            width: parent.width;
            height: parent.height;
            background: rgba(0, 0, 0, 0.6);
            
            Rectangle {
                width: 600px;
                height: 400px;
                background: AppTheme.window_bg;
                border-radius: 8px;
                border-color: AppTheme.border;
                border-width: 1px;
                drop-shadow-blur: 15px;
                drop-shadow-color: rgba(0, 0, 0, 0.3);
                
                VerticalBox {
                    padding: 20px;
                    spacing: 15px;
                    
                    Text { 
                        text: root.browser_is_remote ? "Browse Remote Directory" : "Browse Local Directory"; 
                        font-size: 18px; 
                        font-weight: 700; 
                    }
                    
                    HorizontalBox {
                        Text { text: "Path:"; vertical-alignment: center; }
                        LineEdit { text: root.browser_current_path; edited(t) => { root.browser_current_path = t; } }
                        Button { text: "Go"; clicked => { root.fetch_directory(root.browser_current_path, root.browser_is_remote); } }
                        Button { text: "Up"; clicked => { root.fetch_directory(root.browser_current_path + "/..", root.browser_is_remote); } }
                    }
                    
                    Rectangle {
                        vertical-stretch: 1;
                        background: AppTheme.window_bg; // Changed from AppTheme.item_bg
                        border-width: 1px;
                        border-color: AppTheme.border;
                        ListView {
                            for node[idx] in root.browser_nodes: Rectangle {
                                height: 35px;
                                background: root.browser_selection == node.path ? AppTheme.accent : (ta_browser.has-hover ? rgba(255, 255, 255, 0.1) : transparent);
                                
                                HorizontalBox {
                                    padding: 5px;
                                    spacing: 10px;
                                    Text { text: node.is_dir ? "📁" : "📄"; vertical-alignment: center; }
                                    Text { text: node.name; vertical-alignment: center; }
                                }
                                
                                ta_browser := TouchArea {
                                    clicked => {
                                        root.browser_selection = node.path;
                                    }
                                    double-clicked => {
                                        if node.is_dir {
                                            root.fetch_directory(node.path, root.browser_is_remote);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    
                    HorizontalBox {
                        alignment: end;
                        spacing: 10px;
                        Button { text: "Cancel"; clicked => { root.is_browser_open = false; } }
                        RustButton { text: "Select"; clicked => { root.commit_browser_selection(root.browser_selection); } }
                    }
                }
            }
        }
    }
