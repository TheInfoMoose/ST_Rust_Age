import {
    VerticalBox,
    HorizontalBox,
    ListView,
    LineEdit,
    Palette,
    ScrollView,
} from "std-widgets.slint";

export struct ScheduleData {
    id: string,
    source: string,
    dest: string,
    type: string,
}

export struct TransferQueueItem {
    name: string,
    size: string,
    progress: float,
    snapshot_type: string,
}

export struct CompletedItem {
    name: string,
    status: string,
    status_color: color,
}

export struct DirectoryMapping {
    source: string,
    destination: string,
}

export struct FileNode {
    name: string,
    is_dir: bool,
    path: string,
    is_selected: bool,
    depth: int,
    is_expanded: bool,
    snapshot_type: string,
}

export struct ConnectionItem {
    name: string,
    host: string,
    state: string,
    state_color: color,
    transfer_rate: string,
    duration: string,
    eta: string,
    transfer_type: string,
    token: string,
}

export struct TransferJobUi {
    job_id: string,
    connection_id: string,
    name: string,
    job_type: string,
    source: string,
    destination: string,
    schedule_mode: string,
    sync_frequency: string,
    start_permitted: string,
    finish_permitted: string,
    active_days: string,
    use_snapshots: bool,
}

export struct VolumeUi {
    mount_point: string,
    label: string,
    fs_type: string,
    free_space_label: string,
}

export global AppTheme {
    in-out property <bool> force_light: false;
    out property <color> accent: force_light ? #CB693F : #b94616;
    out property <color> accent_hover: force_light ? #e07b50 : #c95b28;
    out property <color> accent_pressed: force_light ? #b0552b : #943812;
    out property <color> border: force_light ? #D6D6D6 : #333333;
    out property <color> list_hover: force_light ? #E0E0E0 : #333333;
    out property <color> window_bg: force_light ? #F5F5F5 : #141414;
    out property <color> surface: force_light ? #EAEAEA : #222222;
    out property <color> surface_elevated: force_light ? #E2E2E2 : #2A2A2A;
    out property <color> text_muted: force_light ? #666666 : #9E9E9E;
}

export global TooltipState {
    in-out property <string> text: "";
    in-out property <bool> visible: false;
    in-out property <length> anchor_x: 0px;
    in-out property <length> anchor_y: 0px;
    in-out property <length> anchor_w: 0px;
    in-out property <length> anchor_h: 0px;
}

component StyledBox inherits Rectangle {
    border-width: 1px;
    border-color: AppTheme.border;
    border-radius: 6px;
}

component CollapsibleSection inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in-out property <bool> expanded: false;

    border-width: 1px;
    border-color: root.expanded ? AppTheme.accent : AppTheme.border;
    border-radius: 6px;
    background: AppTheme.surface;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Clickable Header Row
        Rectangle {
            height: 40px;
            border-radius: 6px;
            background: header_ta.has-hover ? AppTheme.list_hover : AppTheme.surface_elevated;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                Image {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    source: root.expanded ? @image-url("../../assets/icons/chevron_down.svg") : @image-url("../../assets/icons/chevron_right.svg");
                    colorize: AppTheme.accent;
                }

                Text {
                    text: root.title;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }

                if root.subtitle != "": Text {
                    text: "— " + root.subtitle;
                    font-size: 12px;
                    vertical-alignment: center;
                    color: AppTheme.text_muted;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if root.subtitle == "": Rectangle {
                    horizontal-stretch: 1;
                }
            }

            header_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.expanded = !root.expanded;
                }
            }
        }

        if root.expanded: Rectangle {
            height: 1px;
            background: AppTheme.border;
        }

        Rectangle {
            visible: root.expanded;
            height: root.expanded ? body_layout.preferred-height : 0px;
            clip: true;

            body_layout := VerticalLayout {
                width: 100%;
                padding: 14px;
                spacing: 8px;
                @children
            }
        }
    }
}

component TopNavIconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> selected: false;
    in property <string> tooltip: "";
    callback clicked <=> touch.clicked;

    width: 42px;
    height: 36px;
    border-radius: 6px;
    border-width: root.selected ? 1.5px : 0px;
    border-color: root.selected ? AppTheme.accent : transparent;
    background: touch.has-hover ? AppTheme.list_hover : transparent;
    animate background, border-color { duration: 150ms; }

    Image {
        width: 22px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.selected ? AppTheme.accent : (touch.has-hover ? Palette.foreground : AppTheme.text_muted);
    }

    // Fast 220ms tooltip delay for icon-only buttons
    Timer {
        interval: 220ms;
        running: touch.has-hover && root.tooltip != "";
        triggered => {
            if (touch.has-hover && root.tooltip != "") {
                TooltipState.text = root.tooltip;
                TooltipState.anchor_x = root.absolute-position.x;
                TooltipState.anchor_y = root.absolute-position.y;
                TooltipState.anchor_w = root.width;
                TooltipState.anchor_h = root.height;
                TooltipState.visible = true;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (!self.has-hover && TooltipState.text == root.tooltip) {
                TooltipState.visible = false;
            }
        }
        clicked => {
            if (TooltipState.text == root.tooltip) {
                TooltipState.visible = false;
            }
        }
    }
}

component SecondaryTabButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected: false;
    in property <string> tooltip: "";
    callback clicked <=> touch.clicked;

    width: max(108px, lbl.preferred-width + 48px);
    height: 48px;
    background: transparent;

    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 3px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            Image {
                width: 18px;
                height: 18px;
                source: root.icon;
                colorize: root.selected ? AppTheme.accent : (touch.has-hover ? Palette.foreground : AppTheme.text_muted);
            }
        }

        lbl := Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: root.selected ? Palette.foreground : (touch.has-hover ? Palette.foreground : AppTheme.text_muted);
        }
    }

    // Bottom underline highlight
    Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.selected ? AppTheme.accent : (touch.has-hover ? AppTheme.border : transparent);
        animate background { duration: 150ms; }
    }

    // Slightly longer 650ms tooltip delay for text-labeled buttons
    Timer {
        interval: 650ms;
        running: touch.has-hover && root.tooltip != "";
        triggered => {
            if (touch.has-hover && root.tooltip != "") {
                TooltipState.text = root.tooltip;
                TooltipState.anchor_x = root.absolute-position.x;
                TooltipState.anchor_y = root.absolute-position.y;
                TooltipState.anchor_w = root.width;
                TooltipState.anchor_h = root.height;
                TooltipState.visible = true;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (!self.has-hover && TooltipState.text == root.tooltip) {
                TooltipState.visible = false;
            }
        }
        clicked => {
            if (TooltipState.text == root.tooltip) {
                TooltipState.visible = false;
            }
        }
    }
}

component CustomComboBox inherits Rectangle {
    callback selected(string);

    in property <[string]> model: [];
    in-out property <string> current-value: model.length > 0 ? model[0] : "";
    in-out property <int> current-index: 0;
    in property <bool> solid-accent: false;

    in-out property <bool> popup-visible: false;

    height: 32px;
    min-width: 80px;
    preferred-width: 200px;

    Rectangle {
        background: root.solid-accent ? AppTheme.accent : AppTheme.surface;
        border-radius: 4px;
        border-width: 1px;
        border-color: AppTheme.accent;

        Text {
            text: root.current-value;
            color: root.solid-accent ? white : Palette.foreground;
            vertical-alignment: center;
            horizontal-alignment: left;
            font-size: 13px;
            font-weight: root.solid-accent ? 700 : 400;
            x: 8px;
            width: parent.width - 30px;
            overflow: elide;
        }

        Rectangle {
            height: 18px;
            width: 18px;
            x: parent.width - 23px;
            y: (parent.height - 18px) / 2;
            background: root.solid-accent ? transparent : AppTheme.accent;
            border-radius: 3px;

            Image {
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../../assets/icons/chevron_down.svg");
                colorize: white;
            }
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                popup.show();
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: parent.height;
        width: max(parent.width, 120px);
        height: min(200px, max(1, model.length) * 32px);
        close-policy: close-on-click;

        Rectangle {
            background: AppTheme.surface_elevated;
            border-radius: 4px;
            border-width: 1px;
            border-color: AppTheme.accent;
            width: parent.width;
            height: parent.height;

            ListView {
                for item[index] in model: Rectangle {
                    height: 32px;
                    width: parent.width;
                    background: index == current-index ? AppTheme.accent : (ma2.has-hover ? AppTheme.list_hover : AppTheme.surface_elevated);

                    Text {
                        text: item;
                        color: index == current-index ? white : Palette.foreground;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        x: 8px;
                        width: parent.width - 16px;
                        overflow: elide;
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: AppTheme.accent;
                    }

                    ma2 := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            popup-visible = false;
                            current-value = item;
                            current-index = index;
                            selected(item);
                        }
                    }
                }
            }
        }
    }
}

component RustRadioButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked: false;
    callback clicked();
    height: 20px;

    HorizontalBox {
        spacing: 8px;
        padding: 0;
        alignment: start;

        Rectangle {
            width: 18px;
            height: 18px;
            border-width: 2px;
            border-radius: 9px;
            border-color: root.checked ? AppTheme.accent : AppTheme.text_muted;
            background: transparent;

            if root.checked: Rectangle {
                width: 10px;
                height: 10px;
                x: 4px;
                y: 4px;
                border-radius: 5px;
                background: AppTheme.accent;
            }
        }

        Text {
            text: root.text;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component RustButton inherits Rectangle {
    in property <string> text;
    in property <string> variant: "primary";
    in property <string> tooltip: "";
    callback clicked <=> touch.clicked;

    background: root.variant == "secondary" ? (touch.has-hover ? AppTheme.list_hover : AppTheme.surface_elevated) :
        root.variant == "outline-accent" ? (touch.has-hover ? AppTheme.list_hover : AppTheme.surface) :
        (touch.pressed ? AppTheme.accent_pressed : (touch.has-hover ? AppTheme.accent_hover : AppTheme.accent));
    border-radius: 4px;
    border-width: (root.variant == "secondary" || root.variant == "outline-accent") ? 1px : 0px;
    border-color: root.variant == "outline-accent" ? AppTheme.accent :
        root.variant == "secondary" ? AppTheme.border : transparent;
    height: 30px;
    min-width: max(60px, txt.preferred-width + 24px);
    animate background { duration: 150ms; }

    txt := Text {
        text: root.text;
        color: (root.variant == "secondary" || root.variant == "outline-accent") ? Palette.foreground : white;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 500;
    }

    // Slightly longer 650ms tooltip delay for buttons with text
    Timer {
        interval: 650ms;
        running: touch.has-hover && root.tooltip != "";
        triggered => {
            if (touch.has-hover && root.tooltip != "") {
                TooltipState.text = root.tooltip;
                TooltipState.anchor_x = root.absolute-position.x;
                TooltipState.anchor_y = root.absolute-position.y;
                TooltipState.anchor_w = root.width;
                TooltipState.anchor_h = root.height;
                TooltipState.visible = true;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (!self.has-hover && TooltipState.text == root.tooltip) {
                TooltipState.visible = false;
            }
        }
        clicked => {
            if (TooltipState.text == root.tooltip) {
                TooltipState.visible = false;
            }
        }
    }
}

component RustIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> variant: "outline-accent";
    in property <string> tooltip: "";
    callback clicked <=> touch.clicked;

    width: 32px;
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.variant == "outline-accent" ? AppTheme.accent : AppTheme.border;
    background: touch.has-hover ? AppTheme.list_hover : AppTheme.surface_elevated;
    animate background { duration: 150ms; }

    Image {
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: touch.has-hover ? AppTheme.accent : Palette.foreground;
    }

    // Fast 220ms tooltip delay for icon-only buttons
    Timer {
        interval: 220ms;
        running: touch.has-hover && root.tooltip != "";
        triggered => {
            if (touch.has-hover && root.tooltip != "") {
                TooltipState.text = root.tooltip;
                TooltipState.anchor_x = root.absolute-position.x;
                TooltipState.anchor_y = root.absolute-position.y;
                TooltipState.anchor_w = root.width;
                TooltipState.anchor_h = root.height;
                TooltipState.visible = true;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (!self.has-hover && TooltipState.text == root.tooltip) {
                TooltipState.visible = false;
            }
        }
        clicked => {
            if (TooltipState.text == root.tooltip) {
                TooltipState.visible = false;
            }
        }
    }
}

component RustCheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    callback toggled(bool);
    height: 20px;

    HorizontalBox {
        spacing: 8px;
        padding: 0;
        alignment: start;

        Rectangle {
            width: 18px;
            height: 18px;
            border-width: 2px;
            border-radius: 3px;
            border-color: root.checked ? AppTheme.accent : AppTheme.text_muted;
            background: root.checked ? AppTheme.accent : transparent;

            if root.checked: Image {
                width: 13px;
                height: 13px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../../assets/icons/check.svg");
                colorize: white;
            }
        }

        Text {
            text: root.text;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component TransferQueueRow inherits Rectangle {
    in property <TransferQueueItem> file;
    height: 25px;
    HorizontalBox {
        padding: 0;
        spacing: 10px;
        Rectangle {
            width: 39%;
            Text {
                width: 100%;
                text: root.file.name;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 18%;
            min-width: 90px;
            Text {
                width: parent.width;
                height: parent.height;
                font-family: "monospace";
                text: root.file.size;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle {
            width: 23%;
            min-width: 110px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            border-width: 1px;
            border-color: AppTheme.border;
            background: rgba(128, 128, 128, 0.2);
            clip: true;
            Rectangle {
                x: 0px;
                y: 0px;
                height: parent.height;
                width: parent.width * clamp(root.file.progress, 0.0, 1.0);
                border-radius: 6px;
                background: AppTheme.accent;
            }
        }

        Rectangle {
            width: 10%;
            min-width: 48px;
            Text {
                width: parent.width;
                height: parent.height;
                font-family: "monospace";
                text: Math.round(clamp(root.file.progress, 0.0, 1.0) * 100) + "%";
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 10%;
            min-width: 44px;
            height: 18px;
            border-radius: 4px;
            background: root.file.snapshot_type == "VSS" ? #4CAF50 :
                root.file.snapshot_type == "APFS" ? #2196F3 :
                root.file.snapshot_type == "LVM" ? #FF9800 : #9E9E9E;
            Text {
                text: root.file.snapshot_type;
                color: white;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}

component CompletedQueueRow inherits Rectangle {
    in property <CompletedItem> file;
    height: 25px;
    HorizontalBox {
        padding: 0;
        spacing: 10px;
        Rectangle {
            width: 60%;
            Text {
                width: 100%;
                text: root.file.name;
                overflow: elide;
            }
        }

        Rectangle {
            width: 40%;
            Text {
                width: 100%;
                text: root.file.status;
                color: root.file.status_color;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

component MetricsGrid inherits Rectangle {
    in property <string> upload_speed: "0 MB/s";
    in property <string> download_speed: "0 MB/s";
    in property <string> eta: "0s";

    HorizontalBox {
        padding: 0;
        spacing: 20px;
        alignment: start;
        HorizontalBox {
            padding: 0;
            alignment: start;
            Text {
                text: "Upload:";
                vertical-alignment: center;
            }

            Text {
                text: root.upload_speed;
                width: 8%;
                min-width: 95px;
                font-family: "monospace";
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            padding: 0;
            alignment: start;
            Text {
                text: "Download:";
                vertical-alignment: center;
            }

            Text {
                text: root.download_speed;
                width: 8%;
                min-width: 95px;
                font-family: "monospace";
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            padding: 0;
            alignment: start;
            Text {
                text: "ETA:";
                vertical-alignment: center;
            }

            Text {
                text: root.eta;
                width: 8%;
                min-width: 95px;
                font-family: "monospace";
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Simply Transfer";
    icon: @image-url("../../assets/logo.png");
    min-width: 1000px;
    min-height: 750px;
    background: AppTheme.window_bg;

    // Callbacks for Rust backend
    callback start_transfer();
    callback add_connection();
    callback commit_connection(ConnectionItem);
    callback delete_connection(int);
    callback verify_remote_token(string);
    callback copy_token();
    callback copy_text(string);
    callback open_url(string);
    callback open_log_file(string);
    callback generate_key(string) -> string;
    callback remove_key();
    callback pause_transfer();
    callback cancel_transfer();
    callback refresh_browsers();
    callback request_os_permissions();

    callback cancel_key_generation(string);
    callback purge_orphaned_keys() -> int;

    // File browsing callbacks
    callback browse_source(int);
    callback browse_destination(int);
    callback add_mapping();
    callback remove_mapping(int);
    callback update_mapping_source(int, string);
    callback update_mapping_destination(int, string);

    // Remote browser callbacks
    callback fetch_directory(string, bool, bool); // path, is_remote, is_dest
    callback commit_browser_selection([string], [string]); // source_paths, dest_paths
    callback toggle_browser_selection(string, bool); // path, is_dest
    callback expand_browser_node(FileNode, bool, bool); // node, is_remote, is_dest
    callback collapse_browser_node(FileNode, bool); // node, is_dest

    // System Info States
    in property <string> os_processor_info: "Processor: Unknown";
    in property <string> os_memory_info: "RAM: Unknown";
    // Properties updated by backend
    in-out property <int> active_tab: 0;
    in property <[ScheduleData]> schedules: [];
    callback delete_schedule(string);
    in property <[TransferQueueItem]> transfer_queue: [];
    in property <[CompletedItem]> completed_queue: [];
    in property <string> overall_status: "Completed: 0 / 0 files";
    in property <string> phase_text: "Live Transfer Queue";

    // Browser States
    in-out property <bool> browser_is_remote: false;
    in-out property <int> browser_target_idx: 0;
    in-out property <string> browser_current_path: "/";
    in-out property <[FileNode]> browser_nodes: [];
    in-out property <[string]> browser_selection: [];
    in-out property <bool> browser_is_source: false;

    // Destination browser state
    in-out property <string> dest_browser_current_path: "/";
    in-out property <bool> dest_browser_is_remote: true;
    in-out property <[FileNode]> dest_browser_nodes: [];
    in-out property <[string]> dest_browser_selection: [];
    in-out property <[VolumeUi]> local_volumes: [];
    in-out property <[VolumeUi]> remote_volumes: [];
    in-out property <[string]> local_volume_labels: ["/"];
    in-out property <[string]> remote_volume_labels: ["/"];
    in-out property <string> current_local_volume: "/";
    in-out property <string> current_remote_volume: "/";

    // Dashboard States
    in-out property <[ConnectionItem]> connections: [];
    in-out property <int> selected_connection_idx: 0;
    in-out property <bool> is_editing_connection: false;
    in-out property <bool> is_adding_connection: false;
    in-out property <int> add_connection_tab: 0;
    in-out property <int> active_transfer_tab: 0;
    in-out property <bool> is_remote_verified: false;
    in-out property <string> remote_verified_full_token: "";
    in-out property <string> remote_verification_status: "";
    in-out property <string> remote_verified_host: "";
    in-out property <bool> vpn_enabled: false;
    in-out property <string> vpn_conf_path: "";
    in-out property <string> vpn_endpoint: "";
    in-out property <string> vpn_interface_ip: "";
    in-out property <string> vpn_masked_pubkey: "";
    in-out property <string> vpn_tunnel_status: "Disabled";
    callback import_wireguard_conf(string);
    callback toggle_vpn(bool);
    callback test_vpn_connection();
    callback update_connection(int, string, string, string);

    in property <string> network_link_type: "Dynamic";
    in property <string> network_max_throughput: "Variable";

    // Transfer Setup States
    in-out property <[DirectoryMapping]> current_mappings: [];
    in-out property <[TransferJobUi]> connection_jobs: [];
    in-out property <TransferJobUi> draft_job: {
        job_id: "",
        connection_id: "",
        name: "Default Transfer Task",
        job_type: "Single Transfer",
        source: "",
        destination: "",
        schedule_mode: "Manual",
        sync_frequency: "1hr",
        start_permitted: "00:00",
        finish_permitted: "23:59",
        active_days: "MTWThF",
        use_snapshots: true,
    };
    in-out property <[bool]> active_days_flags: [true, true, true, true, true, false, false];
    callback toggle_active_day(int, bool);

    in-out property <int> selected_job_idx: -1;
    in-out property <int> open_menu_job_idx: -1;
    in-out property <int> editing_job_idx: -1;
    in-out property <bool> is_naming_new_job: false;
    in-out property <string> new_job_name_draft: "";
    in-out property <bool> is_job_setup_unlocked: false;
    in-out property <string> purge_keys_status: "";
    in-out property <string> os_permissions_status: "";
    callback connection_selected(int);
    callback new_transfer_clicked();
    callback create_named_transfer_job(string);
    callback select_transfer_job(int);
    callback delete_transfer_job(int);
    callback rename_transfer_job(int, string);
    callback save_draft_job();

    // Active Transfers States
    in property <[string]> active_sessions: [];
    in-out property <int> selected_session_idx: 0;
    in-out property <string> metric_upload: "0.0 MB/s";
    in-out property <string> metric_download: "0.0 MB/s";
    in-out property <string> metric_eta: "0s";
    in-out property <string> current_phase: "Idle";
    in-out property <bool> is_transfer_paused: false;
    property <int> tick: 0;
    property <string> ellipsis: root.tick == 0 ? "" : (root.tick == 1 ? "." : (root.tick == 2 ? ".." : "..."));

    Timer {
        interval: 500ms;
        running: root.current_phase != "Idle" && root.current_phase != "Transfer Complete" && root.current_phase != "";
        triggered => {
            root.tick = Math.mod(root.tick + 1, 4);
        }
    }

    // Settings States
    in-out property <int> selected_setting_idx: 0;
    in-out property <string> current_theme: "Dark";

    init => {
        AppTheme.force_light = (root.current_theme == "Light");
        Palette.color-scheme = (root.current_theme == "Light") ? ColorScheme.light : ColorScheme.dark;
    }

    changed current_theme => {
        AppTheme.force_light = (root.current_theme == "Light");
        if (root.current_theme == "Dark") {
            Palette.color-scheme = ColorScheme.dark;
        } else if (root.current_theme == "Light") {
            Palette.color-scheme = ColorScheme.light;
        } else {
            Palette.color-scheme = ColorScheme.dark;
        }
    }

    // --- Main VerticalBox (Child of MainWindow) ---
    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // --- Primary Top Navigation Bar (Solid Gray Bar with Borderless Icon Buttons) ---
        Rectangle {
            height: 48px;
            background: AppTheme.surface_elevated;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 12px;

                // Left-aligned loosely stacked icons: Dashboard (Monitor) & Transfer (Stacked Left/Right Arrows)
                TopNavIconButton {
                    icon: @image-url("../../assets/icons/monitor.svg");
                    selected: root.active_tab == 0;
                    tooltip: "Connections Dashboard";
                    clicked => { root.active_tab = 0; }
                }

                TopNavIconButton {
                    icon: @image-url("../../assets/icons/transfer_arrows.svg");
                    selected: root.active_tab == 1;
                    tooltip: "File Transfer Setup & Active Queue";
                    clicked => {
                        root.active_tab = 1;
                        root.refresh_browsers();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // Right-aligned Settings (Gear Outline)
                TopNavIconButton {
                    icon: @image-url("../../assets/icons/settings_gear.svg");
                    selected: root.active_tab == 2;
                    tooltip: "Application Settings & Help";
                    clicked => { root.active_tab = 2; }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: AppTheme.border;
            }
        }

        // --- Dashboard Tab View ---
        if root.active_tab == 0: Rectangle {
            vertical-stretch: 1;
            // Left Column: Active Connections
            StyledBox {
                x: 15px;
                y: 15px;
                width: parent.width * 0.35 - 22.5px;
                height: parent.height - 30px;
                VerticalBox {
                    padding-top: 15px;
                    padding-bottom: 15px;
                    padding-left: 0px;
                    padding-right: 0px;
                    HorizontalBox {
                        padding-left: 16px;
                        padding-bottom: 8px;
                        Text {
                            text: "Active Connections";
                            font-weight: 800;
                            font-size: 16px;
                        }
                    }

                    ListView {
                        for item[idx] in root.connections: Rectangle {
                            height: 40px;
                            background: root.selected_connection_idx == idx ? AppTheme.accent : (touch.has-hover ? AppTheme.list_hover : transparent);
                            touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.selected_connection_idx = idx; root.is_editing_connection = false; root.is_adding_connection = false; root.connection_selected(idx); }
                            }

                            HorizontalBox {
                                padding-left: 16px;
                                padding-right: 16px;
                                Text {
                                    text: item.name;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                    width: 11%;
                                    min-width: 110px;
                                    font-weight: 700;
                                    overflow: elide;
                                    color: root.selected_connection_idx == idx ? white : Palette.foreground;
                                }

                                Text {
                                    text: item.state;
                                    color: root.selected_connection_idx == idx ? white : item.state_color;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    horizontal-stretch: 1;
                                    font-weight: 700;
                                }

                                Text {
                                    text: item.transfer_rate;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    width: 8%;
                                    min-width: 75px;
                                    font-family: "monospace";
                                    font-weight: 700;
                                    color: root.selected_connection_idx == idx ? white : Palette.foreground;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 10px;
                    }

                    HorizontalBox {
                        padding-left: 16px;
                        padding-right: 16px;
                        RustButton {
                            text: "+ New Connection";
                            tooltip: "Create a new P2P host connection or verify a remote peer token.";
                            horizontal-stretch: 1;
                            clicked => {
                                root.is_adding_connection = true;
                                root.is_editing_connection = false;
                            }
                        }
                    }
                }
            }

            // Right Column: Connection Details
            StyledBox {
                x: parent.width * 0.35 + 7.5px;
                y: 15px;
                width: parent.width * 0.65 - 22.5px;
                height: parent.height - 30px;
                VerticalBox {
                    padding: 15px;
                    if !root.is_adding_connection && !root.is_editing_connection && root.connections.length > 0: HorizontalBox {
                        alignment: end;
                        RustIconButton {
                            icon: @image-url("../../assets/icons/minus.svg");
                            tooltip: "Delete selected connection";
                            clicked => {
                                root.delete_connection(root.selected_connection_idx);
                            }
                        }
                    }

                    if !root.is_adding_connection && !root.is_editing_connection && root.connections.length > 0: VerticalBox {
                        Text {
                            text: "Connection Details";
                            font-weight: 700;
                            font-size: 18px;
                        }

                        Rectangle {
                            height: 10px;
                        }

                        spacing: 8px;
                        Text {
                            text: "Name: " + root.connections[root.selected_connection_idx].name;
                        }

                        Text {
                            text: "Host: " + root.connections[root.selected_connection_idx].host;
                        }

                        HorizontalBox {
                            padding: 0;
                            spacing: 0;
                            Text {
                                text: "State: ";
                            }

                            Text {
                                text: root.connections[root.selected_connection_idx].state;
                                color: root.connections[root.selected_connection_idx].state_color;
                            }
                        }

                        Text {
                            text: "Transfer Rate: " + root.connections[root.selected_connection_idx].transfer_rate;
                        }

                        Text {
                            text: "Duration: " + root.connections[root.selected_connection_idx].duration;
                        }

                        Text {
                            text: "Estimated Completion: " + root.connections[root.selected_connection_idx].eta;
                        }

                        Text {
                            text: "Type of Transfer: " + root.connections[root.selected_connection_idx].transfer_type;
                        }

                        HorizontalBox {
                            padding: 0;
                            spacing: 8px;
                            Text {
                                text: "WAN VPN Tunnel:";
                                vertical-alignment: center;
                            }

                            Rectangle {
                                height: 20px;
                                min-width: 90px;
                                border-radius: 4px;
                                background: root.vpn_enabled ? #2E7D32 : #616161;
                                Text {
                                    text: root.vpn_tunnel_status;
                                    color: white;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                        }

                        if root.vpn_enabled && root.vpn_endpoint != "": Text {
                            text: "VPN Endpoint: " + root.vpn_endpoint + " | Interface IP: " + root.vpn_interface_ip + " | Peer Key: " + root.vpn_masked_pubkey;
                            font-size: 11px;
                            color: AppTheme.text_muted;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }

                        HorizontalBox {
                            Text {
                                text: "Destination Token:";
                                vertical-alignment: center;
                            }

                            LineEdit {
                                text: root.connections[root.selected_connection_idx].token;
                                read-only: true;
                            }

                            RustButton {
                                variant: "outline-accent";
                                text: "Copy";
                                tooltip: "Copy the destination security token to the clipboard to share with the remote peer.";
                                clicked => { root.copy_token(); }
                            }
                        }

                        RustButton {
                            variant: "outline-accent";
                            text: "Edit Connection";
                            tooltip: "Modify the name, host address, security key, or WireGuard VPN settings for this connection.";
                            clicked => { root.is_editing_connection = true; }
                        }
                    }

                    if root.is_editing_connection && root.connections.length > 0: VerticalBox {
                        HorizontalBox {
                            alignment: end;
                            RustIconButton {
                                icon: @image-url("../../assets/icons/minus.svg");
                                tooltip: "Delete selected connection";
                                clicked => {
                                    root.delete_connection(root.selected_connection_idx);
                                    root.is_editing_connection = false;
                                }
                            }
                        }

                        Text {
                            text: "Edit Connection";
                            font-weight: 700;
                            font-size: 18px;
                        }

                        Rectangle {
                            height: 10px;
                        }

                        spacing: 8px;
                        HorizontalBox {
                            Text {
                                text: "Name:";
                                width: 10%;
                                min-width: 100px;
                                vertical-alignment: center;
                            }

                            edit_name := LineEdit {
                                text: root.connections[root.selected_connection_idx].name;
                            }
                        }

                        HorizontalBox {
                            Text {
                                text: "Host:";
                                width: 10%;
                                min-width: 100px;
                                vertical-alignment: center;
                            }

                            edit_host := LineEdit {
                                text: root.connections[root.selected_connection_idx].host;
                            }
                        }

                        HorizontalBox {
                            Text {
                                text: "Key:";
                                width: 10%;
                                min-width: 100px;
                                vertical-alignment: center;
                            }

                            edit_key := LineEdit {
                                text: root.connections[root.selected_connection_idx].token;
                            }

                            RustButton {
                                variant: "outline-accent";
                                text: "Generate";
                                tooltip: "Generate a new Ed25519 keypair and one-time verification token for this connection.";
                                clicked => { edit_key.text = root.generate_key(edit_host.text); }
                            }

                            RustButton {
                                variant: "outline-accent";
                                text: "Remove";
                                tooltip: "Clear the current security key and remove its credentials from this connection.";
                                clicked => { edit_key.text = ""; root.remove_key(); }
                            }
                        }

                        RustCheckBox {
                            text: "Enable Preflight WAN VPN (WireGuard)";
                            checked: root.vpn_enabled;
                            toggled => {
                                root.vpn_enabled = self.checked;
                                root.toggle_vpn(self.checked);
                            }
                        }

                        if root.vpn_enabled: VerticalBox {
                            spacing: 6px;
                            HorizontalBox {
                                Text {
                                    text: "WG Config:";
                                    width: 10%;
                                    min-width: 100px;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    text: root.vpn_conf_path;
                                    placeholder-text: "/path/to/wg0.conf (or click Import .conf)";
                                    edited(t) => { root.vpn_conf_path = t; }
                                }

                                RustButton {
                                    variant: "outline-accent";
                                    text: "Import .conf";
                                    tooltip: "Parse, encrypt in vault, and immediately bring up the persistent WireGuard VPN tunnel.";
                                    clicked => { root.import_wireguard_conf(root.vpn_conf_path); }
                                }

                                RustButton {
                                    variant: "secondary";
                                    text: "Verify VPN";
                                    tooltip: "Verify that the WireGuard tunnel interface is up and confirm peer handshake.";
                                    clicked => { root.test_vpn_connection(); }
                                }
                            }

                            HorizontalBox {
                                spacing: 8px;
                                Text {
                                    text: "VPN Status:";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.vpn_tunnel_status;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: AppTheme.accent;
                                    vertical-alignment: center;
                                }
                            }

                            if root.vpn_endpoint != "": Text {
                                text: "Endpoint: " + root.vpn_endpoint + " | Tunnel IP: " + root.vpn_interface_ip + " | Peer Key: " + root.vpn_masked_pubkey;
                                font-size: 11px;
                                color: AppTheme.text_muted;
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }

                        HorizontalBox {
                            alignment: end;
                            spacing: 10px;
                            RustButton {
                                variant: "secondary";
                                text: "Cancel";
                                tooltip: "Discard changes and return to the connection details view.";
                                clicked => { root.is_editing_connection = false; }
                            }

                            RustButton {
                                variant: "primary";
                                text: "Commit";
                                tooltip: "Save the updated connection configuration.";
                                clicked => {
                                    root.update_connection(
                                        root.selected_connection_idx,
                                        edit_name.text,
                                        edit_host.text,
                                        edit_key.text
                                    );
                                    root.is_editing_connection = false;
                                }
                            }
                        }
                    }

                    if root.is_adding_connection: VerticalBox {
                        // Secondary Bar for Add Connection (Offset horizontally with stacked primitive icons + underline)
                        Rectangle {
                            height: 50px;
                            Rectangle {
                                y: parent.height - 1px;
                                width: 100%;
                                height: 1px;
                                background: AppTheme.border;
                            }

                            HorizontalLayout {
                                padding-top: 2px;
                                padding-left: 24px;
                                spacing: 0px;
                                alignment: start;

                                SecondaryTabButton {
                                    icon: @image-url("../../assets/icons/new_conn.svg");
                                    label: "New";
                                    tooltip: "Create a new P2P connection and generate a security token for a remote peer.";
                                    selected: root.add_connection_tab == 0;
                                    clicked => { root.add_connection_tab = 0; }
                                }

                                SecondaryTabButton {
                                    icon: @image-url("../../assets/icons/remote_conn.svg");
                                    label: "Remote";
                                    tooltip: "Connect to a peer by pasting and verifying the security token they generated.";
                                    selected: root.add_connection_tab == 1;
                                    clicked => { root.add_connection_tab = 1; }
                                }
                            }
                        }

                        StyledBox {
                            border-top-left-radius: 0px;
                            if root.add_connection_tab == 0: VerticalBox {
                                Text {
                                    text: "New Connection (Host / Generate Token)";
                                    font-weight: 700;
                                    font-size: 16px;
                                }

                                Text {
                                    text: "Generate a connection token on this machine and share it with the remote device.";
                                    font-size: 11px;
                                    color: AppTheme.text_muted;
                                }

                                Rectangle {
                                    height: 6px;
                                }

                                spacing: 8px;
                                RustCheckBox {
                                    text: "Step 1 (Optional): Enable Preflight WAN VPN (WireGuard)";
                                    checked: root.vpn_enabled;
                                    toggled => {
                                        root.vpn_enabled = self.checked;
                                        root.toggle_vpn(self.checked);
                                    }
                                }

                                if root.vpn_enabled: VerticalBox {
                                    spacing: 6px;
                                    Text {
                                        text: "Import your WireGuard .conf before generating a key so this device's VPN tunnel IP is embedded in the token and stays connected.";
                                        font-size: 11px;
                                        color: AppTheme.text_muted;
                                        wrap: word-wrap;
                                    }

                                    HorizontalBox {
                                        Text {
                                            text: "WG Config:";
                                            width: 10%;
                                            min-width: 100px;
                                            vertical-alignment: center;
                                        }

                                        LineEdit {
                                            text: root.vpn_conf_path;
                                            placeholder-text: "/path/to/wg0.conf (or click Import .conf)";
                                            edited(t) => { root.vpn_conf_path = t; }
                                        }

                                        RustButton {
                                            variant: "outline-accent";
                                            text: "Import .conf";
                                            tooltip: "Parse, encrypt in vault, and immediately bring up the persistent WireGuard VPN tunnel.";
                                            clicked => { root.import_wireguard_conf(root.vpn_conf_path); }
                                        }

                                        RustButton {
                                            variant: "secondary";
                                            text: "Verify VPN";
                                            tooltip: "Verify that the WireGuard tunnel interface is up and confirm peer handshake.";
                                            clicked => { root.test_vpn_connection(); }
                                        }
                                    }

                                    HorizontalBox {
                                        spacing: 8px;
                                        Text {
                                            text: "VPN Status:";
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.vpn_tunnel_status;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if root.vpn_endpoint != "": Text {
                                        text: "Endpoint: " + root.vpn_endpoint + " | Local Tunnel IP: " + root.vpn_interface_ip + " | Peer Key: " + root.vpn_masked_pubkey;
                                        font-size: 11px;
                                        color: AppTheme.text_muted;
                                    }
                                }

                                HorizontalBox {
                                    Text {
                                        text: "Name:";
                                        width: 10%;
                                        min-width: 100px;
                                        vertical-alignment: center;
                                    }

                                    new_name := LineEdit {
                                        placeholder-text: "Connection Name";
                                    }
                                }

                                HorizontalBox {
                                    Text {
                                        text: "Host:";
                                        width: 10%;
                                        min-width: 100px;
                                        vertical-alignment: center;
                                    }

                                    new_host := LineEdit {
                                        placeholder-text: "Optional peer IP (auto-filled when peer verifies token)";
                                    }
                                }

                                HorizontalBox {
                                    Text {
                                        text: "Key:";
                                        width: 10%;
                                        min-width: 100px;
                                        vertical-alignment: center;
                                    }

                                    new_key := LineEdit {
                                        placeholder-text: "Click Generate, then Commit to copy your st:... token";
                                    }

                                    RustButton {
                                        variant: "outline-accent";
                                        text: "Generate";
                                        tooltip: "Generate an Ed25519 keypair and listen for the remote peer to verify your token.";
                                        clicked => { new_key.text = root.generate_key(new_host.text); }
                                    }
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                }

                                HorizontalBox {
                                    alignment: end;
                                    spacing: 10px;
                                    RustButton {
                                        variant: "secondary";
                                        text: "Cancel";
                                        tooltip: "Abort creating this connection and discard any unverified key.";
                                        clicked => { root.is_adding_connection = false; root.cancel_key_generation(new_key.text); }
                                    }

                                    RustButton {
                                        variant: "primary";
                                        text: "Commit";
                                        tooltip: "Save this connection profile to Active Connections.";
                                        clicked => {
                                            root.is_adding_connection = false;
                                            root.commit_connection({
                                                name: new_name.text,
                                                host: new_host.text,
                                                state: "Idle",
                                                state_color: Colors.gray,
                                                transfer_rate: "-",
                                                duration: "-",
                                                eta: "-",
                                                transfer_type: "Single Transfer",
                                                token: new_key.text
                                            });
                                        }
                                    }
                                }
                            }
                            if root.add_connection_tab == 1: VerticalBox {
                                Text {
                                    text: "Remote Connection (Verify Peer Token)";
                                    font-weight: 700;
                                    font-size: 16px;
                                }

                                Text {
                                    text: "Paste the st:... token generated on the other device to complete mutual key exchange.";
                                    font-size: 11px;
                                    color: AppTheme.text_muted;
                                }

                                Rectangle {
                                    height: 6px;
                                }

                                spacing: 8px;
                                RustCheckBox {
                                    text: "Step 1 (Optional): Enable Preflight WAN VPN (WireGuard)";
                                    checked: root.vpn_enabled;
                                    toggled => {
                                        root.vpn_enabled = self.checked;
                                        root.toggle_vpn(self.checked);
                                    }
                                }

                                if root.vpn_enabled: VerticalBox {
                                    spacing: 6px;
                                    Text {
                                        text: "If the host device is on a remote network, import your WireGuard .conf first so the VPN tunnel is active before clicking Verify.";
                                        font-size: 11px;
                                        color: AppTheme.text_muted;
                                        wrap: word-wrap;
                                    }

                                    HorizontalBox {
                                        Text {
                                            text: "WG Config:";
                                            width: 10%;
                                            min-width: 100px;
                                            vertical-alignment: center;
                                        }

                                        LineEdit {
                                            text: root.vpn_conf_path;
                                            placeholder-text: "/path/to/wg0.conf (or click Import .conf)";
                                            edited(t) => { root.vpn_conf_path = t; }
                                        }

                                        RustButton {
                                            variant: "outline-accent";
                                            text: "Import .conf";
                                            tooltip: "Parse, encrypt in vault, and immediately bring up the persistent WireGuard VPN tunnel.";
                                            clicked => { root.import_wireguard_conf(root.vpn_conf_path); }
                                        }

                                        RustButton {
                                            variant: "secondary";
                                            text: "Verify VPN";
                                            tooltip: "Verify that the WireGuard tunnel interface is up and confirm peer handshake.";
                                            clicked => { root.test_vpn_connection(); }
                                        }
                                    }

                                    HorizontalBox {
                                        spacing: 8px;
                                        Text {
                                            text: "VPN Status:";
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.vpn_tunnel_status;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if root.vpn_endpoint != "": Text {
                                        text: "Endpoint: " + root.vpn_endpoint + " | Local Tunnel IP: " + root.vpn_interface_ip + " | Peer Key: " + root.vpn_masked_pubkey;
                                        font-size: 11px;
                                        color: AppTheme.text_muted;
                                    }
                                }

                                HorizontalBox {
                                    Text {
                                        text: "Token:";
                                        width: 10%;
                                        min-width: 100px;
                                        vertical-alignment: center;
                                    }

                                    remote_token := LineEdit {
                                        placeholder-text: "Paste Remote Token Here (st:...)";
                                    }

                                    RustButton {
                                        variant: "outline-accent";
                                        text: "Verify";
                                        tooltip: "Authenticate and authorize the pasted remote peer token over P2P handshake.";
                                        clicked => {
                                            root.remote_verification_status = "Verifying...";
                                            root.verify_remote_token(remote_token.text);
                                        }
                                    }
                                }

                                if root.remote_verification_status != "": Text {
                                    text: "Status: " + root.remote_verification_status;
                                    color: root.is_remote_verified ? AppTheme.accent : AppTheme.text_muted;
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                }

                                HorizontalBox {
                                    alignment: end;
                                    spacing: 10px;
                                    RustButton {
                                        variant: "secondary";
                                        text: "Cancel";
                                        tooltip: "Cancel remote token verification and return to Connection Details.";
                                        clicked => {
                                            root.is_adding_connection = false;
                                            root.is_remote_verified = false;
                                            root.remote_verification_status = "";
                                        }
                                    }

                                    RustButton {
                                        variant: "primary";
                                        text: "Commit";
                                        tooltip: "Save the verified remote connection to Active Connections.";
                                        clicked => {
                                            if root.is_remote_verified {
                                                root.is_adding_connection = false;
                                                let host_str = root.remote_verified_host != "" ? root.remote_verified_host : "Remote";
                                                root.commit_connection({
                                                    name: "Remote",
                                                    host: host_str,
                                                    state: "Connected",
                                                    state_color: Colors.green,
                                                    transfer_rate: "-",
                                                    duration: "-",
                                                    eta: "-",
                                                    transfer_type: "Remote Transfer",
                                                    token: root.remote_verified_full_token
                                                });
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- Transfer Tab View ---
        if root.active_tab == 1: VerticalBox {
            vertical-stretch: 1;
            padding: 0px;
            spacing: 0px;

            // --- Transfer Secondary Navigation Bar (Offset horizontally so it does NOT line up in a grid with Top Bar) ---
            Rectangle {
                height: 50px;
                background: AppTheme.window_bg;

                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: AppTheme.border;
                }

                HorizontalLayout {
                    // Deliberate horizontal offset (132px) so Setup & Active sit staggered to the right of the Top Bar's Dashboard (16..58px) & Transfer (70..112px) icons
                    padding-top: 2px;
                    padding-left: 132px;
                    padding-right: 16px;
                    spacing: 0px;
                    alignment: start;

                    SecondaryTabButton {
                        icon: @image-url("../../assets/icons/setup_sliders.svg");
                        label: "Setup";
                        tooltip: "Create transfer tasks, browse local and remote directories, and stage path mappings.";
                        selected: root.active_transfer_tab == 0;
                        clicked => { root.active_transfer_tab = 0; }
                    }

                    SecondaryTabButton {
                        icon: @image-url("../../assets/icons/active_pulse.svg");
                        label: "Active";
                        tooltip: "Monitor live transfer queues, throughput metrics, and SHA-256 integrity validation.";
                        selected: root.active_transfer_tab == 1;
                        clicked => { root.active_transfer_tab = 1; }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                if root.active_transfer_tab == 0: HorizontalBox {
                    padding: 15px;
                    spacing: 20px;

                    // Left Column: Connection Tasks list + contextual menu + New Transfer Task button
                    StyledBox {
                        width: 260px;
                        VerticalBox {
                            padding-top: 15px;
                            padding-bottom: 15px;
                            padding-left: 0px;
                            padding-right: 0px;
                            HorizontalBox {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-bottom: 8px;
                                alignment: center;
                                Text {
                                    width: 100%;
                                    text: (root.connections.length > 0 && root.selected_connection_idx >= 0 && root.selected_connection_idx < root.connections.length) ? (root.connections[root.selected_connection_idx].name + " Tasks") : "Connection Tasks";
                                    font-weight: 800;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            if root.is_naming_new_job: Rectangle {
                                height: 42px;
                                background: AppTheme.surface_elevated;
                                border-width: 1px;
                                border-color: AppTheme.accent;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 6px;
                                    new_job_input := LineEdit {
                                        horizontal-stretch: 1;
                                        text <=> root.new_job_name_draft;
                                        placeholder-text: "Default Transfer Task";
                                        init => {
                                            self.focus();
                                        }
                                        accepted(val) => {
                                            root.is_naming_new_job = false;
                                            root.is_job_setup_unlocked = true;
                                            root.create_named_transfer_job(val);
                                        }
                                    }

                                    RustButton {
                                        variant: "primary";
                                        text: "OK";
                                        tooltip: "Confirm the transfer task name (leave blank to use default naming) and unlock setup.";
                                        min-width: 42px;
                                        clicked => {
                                            let submitted = root.new_job_name_draft;
                                            root.is_naming_new_job = false;
                                            root.is_job_setup_unlocked = true;
                                            root.create_named_transfer_job(submitted);
                                        }
                                    }
                                }
                            }

                            ListView {
                                for job[j_idx] in root.connection_jobs: Rectangle {
                                    height: 36px;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 12px;
                                        spacing: 6px;

                                        // Task Row Pill
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 2px;
                                            background: root.selected_job_idx == j_idx ? AppTheme.accent : (job_ta.has-hover ? AppTheme.list_hover : transparent);

                                            job_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.open_menu_job_idx = -1;
                                                    root.is_naming_new_job = false;
                                                    root.is_job_setup_unlocked = true;
                                                    root.selected_job_idx = j_idx;
                                                    root.select_transfer_job(j_idx);
                                                }
                                            }

                                            if root.editing_job_idx != j_idx: Text {
                                                x: 10px;
                                                width: parent.width - 20px;
                                                height: parent.height;
                                                text: job.name;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                                font-weight: 600;
                                                overflow: elide;
                                                color: root.selected_job_idx == j_idx ? white : Palette.foreground;
                                            }

                                            if root.editing_job_idx == j_idx: HorizontalLayout {
                                                padding: 2px;
                                                spacing: 4px;
                                                rename_input := LineEdit {
                                                    horizontal-stretch: 1;
                                                    text: job.name;
                                                    accepted(val) => {
                                                        root.editing_job_idx = -1;
                                                        root.rename_transfer_job(j_idx, val);
                                                    }
                                                }

                                                RustButton {
                                                    variant: "outline-accent";
                                                    text: "OK";
                                                    tooltip: "Save the updated task name.";
                                                    min-width: 36px;
                                                    clicked => {
                                                        root.editing_job_idx = -1;
                                                        root.rename_transfer_job(j_idx, rename_input.text);
                                                    }
                                                }
                                            }
                                        }

                                        // 24x24 Contextual Menu Icon Button (Primitive Vertical Dots SVG)
                                        menu_btn := Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 4px;
                                            background: menu_ta.has-hover ? AppTheme.list_hover : transparent;

                                            Image {
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                source: @image-url("../../assets/icons/more_vertical.svg");
                                                colorize: AppTheme.accent;
                                            }

                                            Timer {
                                                interval: 220ms;
                                                running: menu_ta.has-hover;
                                                triggered => {
                                                    if (menu_ta.has-hover) {
                                                        TooltipState.text = "Task Options (Rename / Delete)";
                                                        TooltipState.anchor_x = menu_btn.absolute-position.x;
                                                        TooltipState.anchor_y = menu_btn.absolute-position.y;
                                                        TooltipState.anchor_w = menu_btn.width;
                                                        TooltipState.anchor_h = menu_btn.height;
                                                        TooltipState.visible = true;
                                                    }
                                                }
                                            }

                                            menu_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                changed has-hover => {
                                                    if (!self.has-hover && TooltipState.text == "Task Options (Rename / Delete)") {
                                                        TooltipState.visible = false;
                                                    }
                                                }
                                                clicked => {
                                                    TooltipState.visible = false;
                                                    root.open_menu_job_idx = (root.open_menu_job_idx == j_idx) ? -1 : j_idx;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 10px;
                            }

                            HorizontalBox {
                                padding-left: 16px;
                                padding-right: 16px;
                                RustButton {
                                    variant: "primary";
                                    text: "+ New Transfer Task";
                                    tooltip: "Create and name a new transfer task to unlock the directory setup controls.";
                                    horizontal-stretch: 1;
                                    clicked => {
                                        root.open_menu_job_idx = -1;
                                        root.editing_job_idx = -1;
                                        root.selected_job_idx = -1;
                                        root.new_job_name_draft = "";
                                        root.is_naming_new_job = true;
                                        root.is_job_setup_unlocked = false;
                                        root.new_transfer_clicked();
                                    }
                                }
                            }
                        }

                        // Conditional Popup Action Menu (Edit / Delete) anchored below the vertical-dots button
                        if root.open_menu_job_idx >= 0 && root.open_menu_job_idx < root.connection_jobs.length: Rectangle {
                            x: parent.width - 106px;
                            y: 48px + (root.open_menu_job_idx + 1) * 36px;
                            width: 90px;
                            height: 65px;
                            background: AppTheme.surface_elevated;
                            border-width: 1px;
                            border-color: AppTheme.accent;

                            VerticalLayout {
                                // Row 1: Edit
                                Rectangle {
                                    height: 32px;
                                    background: edit_ta.has-hover ? AppTheme.list_hover : transparent;
                                    Text {
                                        text: "Edit";
                                        color: Palette.foreground;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    edit_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            let target_idx = root.open_menu_job_idx;
                                            root.open_menu_job_idx = -1;
                                            root.is_naming_new_job = false;
                                            root.is_job_setup_unlocked = true;
                                            root.selected_job_idx = target_idx;
                                            root.select_transfer_job(target_idx);
                                            root.editing_job_idx = target_idx;
                                        }
                                    }
                                }

                                // 1px Divider in AppTheme.accent
                                Rectangle {
                                    height: 1px;
                                    width: 100%;
                                    background: AppTheme.accent;
                                }

                                // Row 2: Delete
                                Rectangle {
                                    height: 32px;
                                    background: del_ta.has-hover ? AppTheme.list_hover : transparent;
                                    Text {
                                        text: "Delete";
                                        color: Palette.foreground;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    del_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            let target_idx = root.open_menu_job_idx;
                                            root.open_menu_job_idx = -1;
                                            root.delete_transfer_job(target_idx);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Right Column: 4 Vertical Zones (Zone A, Zone B, Zone C, Zone D)
                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;

                        VerticalBox {
                            width: 100%;
                            height: 100%;
                            padding: 4px;
                            spacing: 10px;
                            opacity: root.is_job_setup_unlocked ? 1.0 : 0.38;
                            animate opacity { duration: 180ms; }

                            // --- Zone A: Header & Transfer Type Configuration ---
                            VerticalBox {
                                padding: 0px;
                                spacing: 8px;

                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 12px;
                                    alignment: start;

                                    Text {
                                        text: "Transfer Type:";
                                        vertical-alignment: center;
                                    }

                                    CustomComboBox {
                                        width: 200px;
                                        model: ["Single Transfer", "Continuous Sync", "Scheduled Transfer"];
                                        current-value: root.draft_job.job_type;
                                        selected(val) => {
                                            root.draft_job.job_type = val;
                                        }
                                    }

                                    if root.draft_job.job_type == "Continuous Sync": HorizontalBox {
                                        padding: 0px;
                                        spacing: 8px;
                                        Text {
                                            text: "Sync Frequency:";
                                            vertical-alignment: center;
                                        }

                                        CustomComboBox {
                                            width: 110px;
                                            model: [
                                                "1min",
                                                "5min",
                                                "15min",
                                                "30min",
                                                "1hr",
                                                "2hr",
                                                "4hr",
                                                "6hr",
                                                "8hr",
                                                "12hr",
                                                "24hr",
                                                "48hr",
                                                "72hr"
                                            ];
                                            current-value: root.draft_job.sync_frequency;
                                            selected(val) => { root.draft_job.sync_frequency = val; }
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    RustCheckBox {
                                        text: "Use Snapshots";
                                        checked <=> root.draft_job.use_snapshots;
                                    }
                                }

                                if root.draft_job.job_type == "Scheduled Transfer": VerticalBox {
                                    padding: 0px;
                                    spacing: 6px;
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 12px;
                                        alignment: start;
                                        Text {
                                            text: "Active Days:";
                                            vertical-alignment: center;
                                        }

                                        RustCheckBox {
                                            text: "M";
                                            checked: root.active_days_flags[0];
                                            toggled(v) => { root.toggle_active_day(0, v); }
                                        }

                                        RustCheckBox {
                                            text: "T";
                                            checked: root.active_days_flags[1];
                                            toggled(v) => { root.toggle_active_day(1, v); }
                                        }

                                        RustCheckBox {
                                            text: "W";
                                            checked: root.active_days_flags[2];
                                            toggled(v) => { root.toggle_active_day(2, v); }
                                        }

                                        RustCheckBox {
                                            text: "Th";
                                            checked: root.active_days_flags[3];
                                            toggled(v) => { root.toggle_active_day(3, v); }
                                        }

                                        RustCheckBox {
                                            text: "F";
                                            checked: root.active_days_flags[4];
                                            toggled(v) => { root.toggle_active_day(4, v); }
                                        }

                                        RustCheckBox {
                                            text: "Sa";
                                            checked: root.active_days_flags[5];
                                            toggled(v) => { root.toggle_active_day(5, v); }
                                        }

                                        RustCheckBox {
                                            text: "Su";
                                            checked: root.active_days_flags[6];
                                            toggled(v) => { root.toggle_active_day(6, v); }
                                        }
                                    }

                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 10px;
                                        alignment: start;
                                        Text {
                                            text: "Start Permitted:";
                                            vertical-alignment: center;
                                        }

                                        CustomComboBox {
                                            width: 110px;
                                            model: ["00:00", "01:00", "02:00", "08:00", "12:00", "18:00", "22:00"];
                                            current-value: root.draft_job.start_permitted;
                                            selected(val) => { root.draft_job.start_permitted = val; }
                                        }

                                        Rectangle {
                                            width: 12px;
                                        }

                                        Text {
                                            text: "Finish Permitted:";
                                            vertical-alignment: center;
                                        }

                                        CustomComboBox {
                                            width: 110px;
                                            model: ["00:00", "06:00", "08:00", "12:00", "18:00", "23:59"];
                                            current-value: root.draft_job.finish_permitted;
                                            selected(val) => { root.draft_job.finish_permitted = val; }
                                        }
                                    }
                                }
                            }

                            // --- Zone B: Inline Dual-Pane Directory Browser ---
                            VerticalBox {
                                padding: 0px;
                                spacing: 8px;
                                vertical-stretch: 1;

                                // Volume Selector Bar
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 0px;

                                    // Source Volume Bar
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 8px;
                                        horizontal-stretch: 1;

                                        CustomComboBox {
                                            width: 95px;
                                            model: root.local_volume_labels;
                                            current-value: root.current_local_volume;
                                            selected(vol) => {
                                                root.current_local_volume = vol;
                                                root.browser_current_path = vol;
                                                root.fetch_directory(vol, root.browser_is_remote, false);
                                            }
                                        }

                                        Text {
                                            text: root.browser_current_path;
                                            color: AppTheme.text_muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        RustIconButton {
                                            icon: @image-url("../../assets/icons/refresh.svg");
                                            tooltip: "Refresh local source directory";
                                            clicked => {
                                                root.fetch_directory(root.browser_current_path, root.browser_is_remote, false);
                                            }
                                        }

                                        RustIconButton {
                                            icon: @image-url("../../assets/icons/arrow_up.svg");
                                            tooltip: "Navigate up one directory level";
                                            clicked => {
                                                root.fetch_directory(root.browser_current_path + "/..", root.browser_is_remote, false);
                                            }
                                        }
                                    }

                                    // Center spacer matching arrow width
                                    Rectangle {
                                        width: 40px;
                                    }

                                    // Destination Volume Bar
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 8px;
                                        horizontal-stretch: 1;

                                        CustomComboBox {
                                            width: 95px;
                                            model: root.remote_volume_labels;
                                            current-value: root.current_remote_volume;
                                            selected(rvol) => {
                                                root.current_remote_volume = rvol;
                                                root.dest_browser_current_path = rvol;
                                                root.fetch_directory(rvol, root.dest_browser_is_remote, true);
                                            }
                                        }

                                        Text {
                                            text: root.dest_browser_current_path;
                                            color: AppTheme.text_muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        RustIconButton {
                                            icon: @image-url("../../assets/icons/refresh.svg");
                                            tooltip: "Refresh remote destination directory";
                                            clicked => {
                                                root.fetch_directory(root.dest_browser_current_path, root.dest_browser_is_remote, true);
                                            }
                                        }

                                        RustIconButton {
                                            icon: @image-url("../../assets/icons/arrow_up.svg");
                                            tooltip: "Navigate up one remote directory level";
                                            clicked => {
                                                root.fetch_directory(root.dest_browser_current_path + "/..", root.dest_browser_is_remote, true);
                                            }
                                        }
                                    }
                                }

                                // Dual Tree-View Boxes
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 0px;
                                    vertical-stretch: 1;

                                    // Left Box (Source)
                                    StyledBox {
                                        horizontal-stretch: 1;
                                        min-height: 220px;
                                        vertical-stretch: 1;
                                        background: AppTheme.surface;

                                        ListView {
                                            for node[idx] in root.browser_nodes: Rectangle {
                                                height: 32px;
                                                background: node.is_selected ? AppTheme.accent : (ta_browser.has-hover ? AppTheme.list_hover : transparent);
                                                ta_browser := TouchArea { }

                                                HorizontalBox {
                                                    padding: 4px;
                                                    padding-left: 8px + (node.depth * 18px);
                                                    spacing: 8px;

                                                    // Selection Checkbox
                                                    Rectangle {
                                                        width: 16px;
                                                        height: 16px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 3px;
                                                        border-width: 1.5px;
                                                        border-color: node.is_selected ? white : AppTheme.text_muted;
                                                        background: node.is_selected ? AppTheme.accent_pressed : transparent;

                                                        if node.is_selected: Image {
                                                            width: 12px;
                                                            height: 12px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            source: @image-url("../../assets/icons/check.svg");
                                                            colorize: white;
                                                        }

                                                        TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.toggle_browser_selection(node.path, false); }
                                                        }
                                                    }

                                                    // Folder / File Icon + Name
                                                    Rectangle {
                                                        horizontal-stretch: 1;
                                                        HorizontalBox {
                                                            padding: 0;
                                                            spacing: 6px;

                                                            if node.is_dir: Image {
                                                                width: 12px;
                                                                height: 12px;
                                                                y: (parent.height - self.height) / 2;
                                                                source: node.is_expanded ? @image-url("../../assets/icons/chevron_down.svg") : @image-url("../../assets/icons/chevron_right.svg");
                                                                colorize: node.is_selected ? white : AppTheme.text_muted;
                                                            }

                                                            Image {
                                                                width: 16px;
                                                                height: 16px;
                                                                y: (parent.height - self.height) / 2;
                                                                source: node.is_dir ? (node.is_expanded ? @image-url("../../assets/icons/folder_open.svg") : @image-url("../../assets/icons/folder.svg")) : @image-url("../../assets/icons/file.svg");
                                                                colorize: node.is_selected ? white : (node.is_dir ? AppTheme.accent : AppTheme.text_muted);
                                                            }

                                                            Text {
                                                                text: node.name;
                                                                vertical-alignment: center;
                                                                color: node.is_selected ? white : Palette.foreground;
                                                                overflow: elide;
                                                            }

                                                            if node.snapshot_type != "": Rectangle {
                                                                width: 40px;
                                                                height: 18px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 4px;
                                                                background: node.snapshot_type == "VSS" ? #4CAF50 :
                                                                    node.snapshot_type == "APFS" ? #2196F3 :
                                                                    node.snapshot_type == "LVM" ? #FF9800 : #9E9E9E;
                                                                Text {
                                                                    text: node.snapshot_type;
                                                                    color: white;
                                                                    font-size: 10px;
                                                                    font-weight: 700;
                                                                    horizontal-alignment: center;
                                                                    vertical-alignment: center;
                                                                    width: parent.width;
                                                                    height: parent.height;
                                                                }
                                                            }
                                                        }

                                                        TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if node.is_dir {
                                                                    if node.is_expanded { root.collapse_browser_node(node, false); }
                                                                    else { root.expand_browser_node(node, root.browser_is_remote, false); }
                                                                } else {
                                                                    root.toggle_browser_selection(node.path, false);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Center Separator Arrow (Primitive Vector Outline)
                                    VerticalBox {
                                        width: 40px;
                                        alignment: center;
                                        padding: 0px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Image {
                                                width: 24px;
                                                height: 24px;
                                                source: @image-url("../../assets/icons/arrow_right.svg");
                                                colorize: AppTheme.accent;
                                            }
                                        }
                                    }

                                    // Right Box (Destination)
                                    StyledBox {
                                        horizontal-stretch: 1;
                                        min-height: 220px;
                                        vertical-stretch: 1;
                                        background: AppTheme.surface;

                                        ListView {
                                            for node[idx] in root.dest_browser_nodes: Rectangle {
                                                height: 32px;
                                                background: node.is_selected ? AppTheme.accent : (ta_dest_browser.has-hover ? AppTheme.list_hover : transparent);
                                                ta_dest_browser := TouchArea { }

                                                HorizontalBox {
                                                    padding: 4px;
                                                    padding-left: 8px + (node.depth * 18px);
                                                    spacing: 8px;

                                                    // Selection Checkbox
                                                    Rectangle {
                                                        width: 16px;
                                                        height: 16px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 3px;
                                                        border-width: 1.5px;
                                                        border-color: node.is_selected ? white : AppTheme.text_muted;
                                                        background: node.is_selected ? AppTheme.accent_pressed : transparent;

                                                        if node.is_selected: Image {
                                                            width: 12px;
                                                            height: 12px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            source: @image-url("../../assets/icons/check.svg");
                                                            colorize: white;
                                                        }

                                                        TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.toggle_browser_selection(node.path, true); }
                                                        }
                                                    }

                                                    // Folder / File Icon + Name
                                                    Rectangle {
                                                        horizontal-stretch: 1;
                                                        HorizontalBox {
                                                            padding: 0;
                                                            spacing: 6px;

                                                            if node.is_dir: Image {
                                                                width: 12px;
                                                                height: 12px;
                                                                y: (parent.height - self.height) / 2;
                                                                source: node.is_expanded ? @image-url("../../assets/icons/chevron_down.svg") : @image-url("../../assets/icons/chevron_right.svg");
                                                                colorize: node.is_selected ? white : AppTheme.text_muted;
                                                            }

                                                            Image {
                                                                width: 16px;
                                                                height: 16px;
                                                                y: (parent.height - self.height) / 2;
                                                                source: node.is_dir ? (node.is_expanded ? @image-url("../../assets/icons/folder_open.svg") : @image-url("../../assets/icons/folder.svg")) : @image-url("../../assets/icons/file.svg");
                                                                colorize: node.is_selected ? white : (node.is_dir ? AppTheme.accent : AppTheme.text_muted);
                                                            }

                                                            Text {
                                                                text: node.name;
                                                                vertical-alignment: center;
                                                                color: node.is_selected ? white : Palette.foreground;
                                                                overflow: elide;
                                                            }

                                                            if node.snapshot_type != "": Rectangle {
                                                                width: 40px;
                                                                height: 18px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 4px;
                                                                background: node.snapshot_type == "VSS" ? #4CAF50 :
                                                                    node.snapshot_type == "APFS" ? #2196F3 :
                                                                    node.snapshot_type == "LVM" ? #FF9800 : #9E9E9E;
                                                                Text {
                                                                    text: node.snapshot_type;
                                                                    color: white;
                                                                    font-size: 10px;
                                                                    font-weight: 700;
                                                                    horizontal-alignment: center;
                                                                    vertical-alignment: center;
                                                                    width: parent.width;
                                                                    height: parent.height;
                                                                }
                                                            }
                                                        }

                                                        TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if node.is_dir {
                                                                    if node.is_expanded { root.collapse_browser_node(node, true); }
                                                                    else { root.expand_browser_node(node, root.dest_browser_is_remote, true); }
                                                                } else {
                                                                    root.toggle_browser_selection(node.path, true);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Center Action Button (Add Row)
                                HorizontalBox {
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    alignment: center;
                                    RustButton {
                                        variant: "outline-accent";
                                        width: 280px;
                                        height: 34px;
                                        text: "Add Row";
                                        tooltip: "Stage the checked source and destination paths into the transfer mapping table below.";
                                        clicked => {
                                            root.commit_browser_selection(root.browser_selection, root.dest_browser_selection);
                                        }
                                    }
                                }
                            }

                            // --- Zone C: Staged Mappings Table (Two-Column Scrollable List) ---
                            VerticalBox {
                                padding: 0px;
                                spacing: 6px;

                                // Top Divider
                                Rectangle {
                                    height: 1px;
                                    width: 100%;
                                    background: AppTheme.border;
                                }

                                ListView {
                                    height: 110px;
                                    for mapping[idx] in root.current_mappings: Rectangle {
                                        height: 34px;
                                        width: parent.width;
                                        background: row_ta.has-hover ? AppTheme.list_hover : AppTheme.surface;
                                        row_ta := TouchArea { }

                                        HorizontalLayout {
                                            padding: 0px;
                                            spacing: 0px;

                                            // Left Column (Source)
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                Text {
                                                    x: 12px;
                                                    width: parent.width - 24px;
                                                    height: parent.height;
                                                    text: mapping.source;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                    color: Palette.foreground;
                                                }
                                            }

                                            // 1px Vertical Divider
                                            Rectangle {
                                                width: 1px;
                                                height: parent.height;
                                                background: AppTheme.border;
                                            }

                                            // Right Column (Destination + Remove Button)
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 8px;
                                                    spacing: 6px;

                                                    Text {
                                                        horizontal-stretch: 1;
                                                        text: mapping.destination;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                        horizontal-alignment: center;
                                                        color: Palette.foreground;
                                                    }

                                                    rm_btn := Rectangle {
                                                        width: 22px;
                                                        height: 22px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 4px;
                                                        opacity: (row_ta.has-hover || rm_ta.has-hover) ? 1.0 : 0.65;
                                                        background: rm_ta.has-hover ? AppTheme.accent : transparent;

                                                        Image {
                                                            width: 13px;
                                                            height: 13px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            source: @image-url("../../assets/icons/close.svg");
                                                            colorize: rm_ta.has-hover ? white : AppTheme.text_muted;
                                                        }

                                                        Timer {
                                                            interval: 220ms;
                                                            running: rm_ta.has-hover;
                                                            triggered => {
                                                                if (rm_ta.has-hover) {
                                                                    TooltipState.text = "Remove staged mapping row";
                                                                    TooltipState.anchor_x = rm_btn.absolute-position.x;
                                                                    TooltipState.anchor_y = rm_btn.absolute-position.y;
                                                                    TooltipState.anchor_w = rm_btn.width;
                                                                    TooltipState.anchor_h = rm_btn.height;
                                                                    TooltipState.visible = true;
                                                                }
                                                            }
                                                        }

                                                        rm_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            changed has-hover => {
                                                                if (!self.has-hover && TooltipState.text == "Remove staged mapping row") {
                                                                    TooltipState.visible = false;
                                                                }
                                                            }
                                                            clicked => {
                                                                TooltipState.visible = false;
                                                                root.remove_mapping(idx);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Bottom Divider
                                Rectangle {
                                    height: 1px;
                                    width: 100%;
                                    background: AppTheme.border;
                                }
                            }

                            // --- Zone D: Footer Commit Bar ---
                            HorizontalBox {
                                padding: 0px;
                                alignment: end;
                                spacing: 10px;
                                RustButton {
                                    variant: "secondary";
                                    text: "Commit";
                                    tooltip: "Save this transfer task configuration without starting the transfer immediately.";
                                    clicked => { root.save_draft_job(); }
                                }

                                RustButton {
                                    variant: "primary";
                                    text: "Commit & Start";
                                    tooltip: "Save this transfer task configuration and begin transferring files immediately.";
                                    clicked => {
                                        root.save_draft_job();
                                        root.start_transfer();
                                    }
                                }
                            }
                        }

                        // Disabled / Locked Guidance Overlay when no task is created/selected yet
                        if !root.is_job_setup_unlocked: Rectangle {
                            width: 100%;
                            height: 100%;
                            background: transparent;

                            TouchArea {
                                // Intercepts clicks while Transfer Setup is locked
                            }

                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 20px;
                                width: min(parent.width - 32px, 560px);
                                height: 52px;
                                border-radius: 6px;
                                border-width: 1.5px;
                                border-color: AppTheme.accent;
                                background: AppTheme.surface_elevated;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 10px;
                                    alignment: center;

                                    Text {
                                        text: root.is_naming_new_job ?
                                            "Enter a name for your new transfer task on the left (or press Enter / OK for default naming) to unlock setup." :
                                            "Click '+ New Transfer Task' on the left to name and initialize a task before selecting files and directories.";
                                        font-weight: 700;
                                        font-size: 12px;
                                        color: Palette.foreground;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                if root.active_transfer_tab == 1: VerticalBox {
                    HorizontalBox {
                        // Left list
                        StyledBox {
                            width: 250px;
                            VerticalBox {
                                padding-top: 15px;
                                padding-bottom: 15px;
                                padding-left: 0px;
                                padding-right: 0px;
                                HorizontalBox {
                                    padding-left: 16px;
                                    padding-bottom: 8px;
                                    Text {
                                        text: "Active Sessions";
                                        font-weight: 800;
                                        font-size: 16px;
                                    }
                                }

                                ListView {
                                    for session[idx] in root.active_sessions: Rectangle {
                                        height: 30px;
                                        background: root.selected_session_idx == idx ? AppTheme.accent : (ta.has-hover ? AppTheme.list_hover : transparent);
                                        ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.selected_session_idx = idx; }
                                        }

                                        HorizontalBox {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            Text {
                                                text: session;
                                                vertical-alignment: center;
                                                font-weight: 700;
                                                color: root.selected_session_idx == idx ? white : Palette.foreground;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Right details
                        StyledBox {
                            horizontal-stretch: 1;
                            VerticalBox {
                                padding: 15px;
                                HorizontalBox {
                                    alignment: end;
                                }

                                Text {
                                    text: root.phase_text;
                                    font-weight: 700;
                                }

                                ListView {
                                    height: 150px;
                                    for file in root.transfer_queue: TransferQueueRow {
                                        file: file;
                                    }
                                }

                                HorizontalBox {
                                    padding: 0;
                                    spacing: 0;
                                    MetricsGrid {
                                        upload_speed: root.metric_upload;
                                        download_speed: root.metric_download;
                                        eta: root.metric_eta;
                                        horizontal-stretch: 1;
                                    }
                                }

                                Rectangle {
                                    height: 10px;
                                }

                                Rectangle {
                                    height: 1px;
                                    background: AppTheme.border;
                                }

                                Rectangle {
                                    height: 10px;
                                }

                                Text {
                                    text: "Integrity Validation";
                                    font-weight: 700;
                                }

                                ListView {
                                    height: 150px;
                                    for file in root.completed_queue: CompletedQueueRow {
                                        file: file;
                                    }
                                }

                                Text {
                                    text: root.overall_status;
                                }

                                HorizontalBox {
                                    spacing: 10px;
                                    RustButton {
                                        variant: "outline-accent";
                                        text: root.is_transfer_paused ? "Resume Transfer" : "Pause Transfer";
                                        tooltip: "Temporarily pause or resume the active file transfer stream.";
                                        clicked => {
                                            root.is_transfer_paused = !root.is_transfer_paused;
                                            root.pause_transfer();
                                        }
                                    }

                                    RustButton {
                                        variant: "outline-accent";
                                        text: "Cancel Transfer";
                                        tooltip: "Stop the current transfer session and clear remaining queued items.";
                                        clicked => { root.cancel_transfer(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } // End of Transfer Tab View

        // --- Settings Tab View ---
        if root.active_tab == 2: Rectangle {
            vertical-stretch: 1;

            // Left Column
            StyledBox {
                x: 15px;
                y: 15px;
                width: 250px;
                height: parent.height - 30px;
                VerticalBox {
                    width: parent.width;
                    height: parent.height;
                    padding-top: 15px;
                    padding-bottom: 15px;
                    padding-left: 0px;
                    padding-right: 0px;
                    ListView {
                        for setting[idx] in [
                            "Display",
                            "Notifications",
                            "Import/Export",
                            "Help",
                            "Logs"
                        ]: Rectangle {
                            height: 40px;
                            background: root.selected_setting_idx == idx ? AppTheme.accent : (sta.has-hover ? AppTheme.list_hover : transparent);
                            sta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.selected_setting_idx = idx; }
                            }

                            HorizontalBox {
                                padding-left: 16px;
                                padding-right: 16px;
                                Text {
                                    text: setting;
                                    vertical-alignment: center;
                                    font-weight: 700;
                                    color: root.selected_setting_idx == idx ? white : Palette.foreground;
                                }
                            }
                        }
                    }
                }
            }

            // Right Column
            StyledBox {
                x: 280px;
                y: 15px;
                width: parent.width - 295px;
                height: parent.height - 30px;
                VerticalBox {
                    width: parent.width;
                    height: parent.height;
                    padding: 15px;
                    padding-left: 20px;

                    if root.selected_setting_idx == 4: VerticalBox {
                        Text {
                            text: "Application Logs";
                            font-size: 20px;
                            font-weight: 700;
                        }

                        Rectangle {
                            height: 10px;
                        }

                        Text {
                            text: "Connection Logs:";
                            font-weight: 700;
                        }

                        Text {
                            text: "Validation and Authentication events";
                            font-size: 11px;
                            color: AppTheme.text_muted;
                        }

                        RustButton {
                            variant: "outline-accent";
                            text: "Open Connection Logs";
                            tooltip: "Open connection.log in your system text viewer to inspect P2P handshakes and authentication.";
                            clicked => { root.open_log_file("connection.log"); }
                        }

                        Rectangle {
                            height: 10px;
                        }

                        Text {
                            text: "Transfers Logs:";
                            font-weight: 700;
                        }

                        Text {
                            text: "Transmission and Validation events";
                            font-size: 11px;
                            color: AppTheme.text_muted;
                        }

                        RustButton {
                            variant: "outline-accent";
                            text: "Open Transfer Logs";
                            tooltip: "Open transfers.log to review QUIC stream progress and SHA-256 verification results.";
                            clicked => { root.open_log_file("transfers.log"); }
                        }

                        Rectangle {
                            height: 10px;
                        }

                        Text {
                            text: "Sync Logs:";
                            font-weight: 700;
                        }

                        Text {
                            text: "Active Sync engine events";
                            font-size: 11px;
                            color: AppTheme.text_muted;
                        }

                        RustButton {
                            variant: "outline-accent";
                            text: "Open Sync Logs";
                            tooltip: "Open sync.log to inspect continuous directory watcher and delta synchronization events.";
                            clicked => { root.open_log_file("sync.log"); }
                        }

                        Rectangle {
                            height: 10px;
                        }

                        Text {
                            text: "Schedule Logs:";
                            font-weight: 700;
                        }

                        Text {
                            text: "Validation of scheduled transfers running";
                            font-size: 11px;
                            color: AppTheme.text_muted;
                        }

                        RustButton {
                            variant: "outline-accent";
                            text: "Open Schedule Logs";
                            tooltip: "Open schedule.log to inspect automated recurring transfer execution history.";
                            clicked => { root.open_log_file("schedule.log"); }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }

                    if root.selected_setting_idx == 0: VerticalBox {
                        Text {
                            text: "Display Settings";
                            font-size: 20px;
                            font-weight: 700;
                        }

                        Rectangle {
                            height: 20px;
                        }

                        HorizontalBox {
                            spacing: 20px;
                            VerticalBox {
                                Image {
                                    source: @image-url("../../assets/theme_dark.png");
                                    width: 200px;
                                    height: 120px;
                                }

                                RustRadioButton {
                                    text: "Dark Mode";
                                    checked: root.current_theme == "Dark";
                                    clicked => { root.current_theme = "Dark"; }
                                }
                            }

                            VerticalBox {
                                Image {
                                    source: @image-url("../../assets/theme_light.png");
                                    width: 200px;
                                    height: 120px;
                                }

                                RustRadioButton {
                                    text: "Light Mode";
                                    checked: root.current_theme == "Light";
                                    clicked => { root.current_theme = "Light"; }
                                }
                            }

                            VerticalBox {
                                Image {
                                    source: @image-url("../../assets/theme_system.png");
                                    width: 200px;
                                    height: 120px;
                                }

                                RustRadioButton {
                                    text: "Match System";
                                    checked: root.current_theme == "Match System";
                                    clicked => { root.current_theme = "Match System"; }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }

                    if root.selected_setting_idx == 1: VerticalBox {
                        Text {
                            text: "Notifications & OS Permissions";
                            font-size: 20px;
                            font-weight: 700;
                        }

                        Rectangle {
                            height: 20px;
                        }

                        HorizontalBox {
                            Text {
                                text: "Notification Type:";
                                vertical-alignment: center;
                            }

                            CustomComboBox {
                                width: 200px;
                                model: ["OS Pop-up", "Email", "None"];
                            }
                        }

                        RustCheckBox {
                            text: "Notify on transfer completion";
                            checked: true;
                        }

                        RustCheckBox {
                            text: "Notify on validation failure";
                            checked: true;
                        }

                        Rectangle {
                            height: 10px;
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 12px;
                            alignment: start;

                            RustButton {
                                variant: "outline-accent";
                                text: "Request OS Permissions";
                                tooltip: "Perform one-time OS firewall and disk access permission setup for Simply Transfer.";
                                clicked => { root.request_os_permissions(); }
                            }

                            if root.os_permissions_status != "": Text {
                                text: root.os_permissions_status;
                                font-size: 11px;
                                color: AppTheme.accent;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 5px;
                        }

                        Text {
                            text: "Note: Permissions are persisted once granted so you will not be prompted repeatedly. If denied, notifications safely fall back to None.";
                            font-size: 11px;
                            color: AppTheme.text_muted;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }

                    if root.selected_setting_idx == 2: VerticalBox {
                        Text {
                            text: "Import/Export Profiles";
                            font-size: 20px;
                            font-weight: 700;
                        }

                        Rectangle {
                            height: 20px;
                        }

                        HorizontalBox {
                            spacing: 10px;
                            RustButton {
                                variant: "outline-accent";
                                text: "Import Profile (.json)";
                                tooltip: "Import saved connection and transfer task profiles from a JSON backup file.";
                            }

                            RustButton {
                                variant: "outline-accent";
                                text: "Export Profile (.json)";
                                tooltip: "Export your connection and transfer task profiles (excluding raw private keys) to a JSON file.";
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }

                    if root.selected_setting_idx == 3: VerticalBox {
                        padding: 0px;
                        spacing: 10px;

                        HorizontalBox {
                            padding: 0px;
                            alignment: space-between;
                            Text {
                                text: "Help & Support";
                                font-size: 20px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Simply Transfer v1.0.0 Production";
                                font-size: 12px;
                                font-weight: 600;
                                color: AppTheme.accent;
                                vertical-alignment: center;
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalBox {
                                padding: 2px;
                                padding-right: 10px;
                                spacing: 10px;

                                // 1. How To Section
                                CollapsibleSection {
                                    title: "How To — Step-by-Step Guide";
                                    subtitle: "Walkthrough for P2P pairing, task creation, sync modes, and VPN tunnels";
                                    expanded: true;

                                    Text {
                                        text: "1. Establish a P2P Connection (Dashboard Tab):";
                                        font-weight: 700;
                                        color: AppTheme.accent;
                                    }
                                    Text {
                                        text: "• On Host A (Initiator): Click '+ New Connection' -> 'New'. Enter a connection name and optional peer IP, click 'Generate' to mint an Ed25519 keypair and st:... token, then click 'Commit' and 'Copy' the token.\n• On Host B (Remote Peer): Click '+ New Connection' -> 'Remote'. Paste the copied token into the Token field, click 'Verify' to complete the encrypted TCP handshake, and click 'Commit'. Both devices will now show 'Connected'.";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }

                                    Text {
                                        text: "2. Create & Name a Transfer Task (Transfer -> Setup Tab):";
                                        font-weight: 700;
                                        color: AppTheme.accent;
                                    }
                                    Text {
                                        text: "• Transition to the Transfer tab (top-left arrows icon). The right-hand setup controls start locked to prevent accidental edits.\n• Click '+ New Transfer Task' on the left panel. Type a custom task name into the ready input box (or leave it blank and press Enter / OK to use default naming). The setup controls will immediately unlock.";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }

                                    Text {
                                        text: "3. Select Directories & Stage Mappings:";
                                        font-weight: 700;
                                        color: AppTheme.accent;
                                    }
                                    Text {
                                        text: "• Use the left pane (Local Source) and right pane (Remote Destination) to browse volumes and folders. Click a folder name to expand it inline, or check the selection boxes next to files/folders.\n• Click 'Add Row' to stage the selected Source -> Destination pair into the bottom mapping table.\n• Choose 'Single Transfer', 'Continuous Sync' (with interval), or 'Scheduled Transfer' (with active days and time window), then click 'Commit' to save or 'Commit & Start' to launch immediately.";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }

                                    Text {
                                        text: "4. Monitor Progress & Scoped WireGuard WAN VPN:";
                                        font-weight: 700;
                                        color: AppTheme.accent;
                                    }
                                    Text {
                                        text: "• Switch to 'Transfer -> Active' to view live multi-stream QUIC throughput, per-file progress bars, snapshot badges (VSS/APFS/LVM), and end-to-end SHA-256 integrity status.\n• For WAN / cross-subnet transfers, check 'Enable WAN VPN (WireGuard)' when creating or editing a connection and import your wg0.conf file.";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }
                                }

                                // 2. Troubleshooting Section (with Purge Orphaned Keys)
                                CollapsibleSection {
                                    title: "Troubleshooting & Credential Maintenance";
                                    subtitle: "Known fixable issues across Linux (Arch/CachyOS), macOS, and Windows";
                                    expanded: false;

                                    Text {
                                        text: "• Destination Directory Shows [Remote Connection Failed] or [Invalid Remote Configuration]:\n  Ensure the remote peer has clicked 'Verify' on your generated token so the connection state is 'Connected', then click the Refresh icon button above the Destination pane. Simply Transfer communicates over built-in P2P port 2222 using native Rust directory traversal.";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }

                                    Text {
                                        text: "• Firewall & Port Requirements (Linux ufw/firewalld, macOS, Windows Defender):\n  Allow TCP Port 2222 (P2P SSH/SFTP control plane), ephemeral UDP ports (QUIC bulk data streams), and ephemeral TCP ports on your LAN interface during initial token verification.\n  - Arch / CachyOS / Ubuntu (ufw): sudo ufw allow 2222/tcp\n  - Fedora / RHEL / CachyOS (firewalld): sudo firewall-cmd --add-port=2222/tcp --permanent && sudo firewall-cmd --reload";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }

                                    Text {
                                        text: "• CachyOS / Arch Linux Keyring (Secret Service / KWallet / GNOME Keyring):\n  On Arch-based distributions where D-Bus Secret Service sessions may lock or reset between threads, Simply Transfer automatically synchronizes generated Ed25519 keys to both the OS keyring and an AES-256-GCM encrypted local vault (~/.simply-transfer/vault.enc).";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }

                                    Text {
                                        text: "• macOS Protected Folders & Full Disk Access (macOS 14–27):\n  If browsing ~/Desktop, ~/Documents, or /Volumes on a macOS peer returns an empty or restricted view, open macOS System Settings -> Privacy & Security -> Full Disk Access and enable Simply Transfer.";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }

                                    Rectangle {
                                        height: 1px;
                                        background: AppTheme.border;
                                    }

                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 12px;
                                        alignment: start;

                                        Text {
                                            text: "Credential Cleanup:";
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        RustButton {
                                            variant: "outline-accent";
                                            text: "Purge Orphaned Keys";
                                            tooltip: "Remove any unreferenced Ed25519 private and public keys from the encrypted vault and peer registry.";
                                            clicked => {
                                                let count = root.purge_orphaned_keys();
                                                if (count > 0) {
                                                    root.purge_keys_status = "Purged " + count + " orphaned key(s) from secure storage.";
                                                } else {
                                                    root.purge_keys_status = "No orphaned keys found — all stored keys belong to active connections.";
                                                }
                                            }
                                        }

                                        if root.purge_keys_status != "": Text {
                                            text: root.purge_keys_status;
                                            font-size: 11px;
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 3. FAQ & Security Auditability Section
                                CollapsibleSection {
                                    title: "FAQ — Feature Highlights & Security Key Locations";
                                    subtitle: "How snapshots, QUIC streams, and local cryptographic storage work";
                                    expanded: false;

                                    Text {
                                        text: "Q: How does Simply Transfer copy open or locked files without corruption?\nA: When 'Use Snapshots' is enabled, Simply Transfer creates a point-in-time volume snapshot before reading: Volume Shadow Copy Service (VSS) on Windows, APFS snapshots on macOS, and LVM snapshots on Linux. If snapshots are unavailable or unprivileged, it gracefully falls back to direct streaming.";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }

                                    Text {
                                        text: "Q: How are files encrypted and verified in transit?\nA: Control metadata and directory listings travel over an Ed25519-authenticated SSHv2 channel (port 2222), while bulk file payloads stream out-of-band over TLS 1.3 QUIC (UDP) channels with end-to-end SHA-256 hash verification on every file.";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }

                                    Text {
                                        text: "Q: Where are my cryptographic keys and connection profiles stored on disk?\nA: You can audit or back up your security state at any time in the following locations:\n  1. OS Hardware Keyring: Stored under service namespace 'com.simplytransfer.app' (macOS Keychain, Windows Credential Manager, Linux Secret Service).\n  2. Encrypted Local Vault: ~/.simply-transfer/vault.enc (AES-256-GCM encrypted with 0600 permissions).\n  3. Authorized Peer Public Keys: ~/.simply-transfer/p2p_authorized_keys.json and ~/.ssh/authorized_keys.\n  4. Connection & Task Metadata: connections_<os>.json and transfer_jobs_<os>.json (stores only key UUID references such as key_<uuid>, never raw private keys).";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }
                                }

                                // 4. Git References Section
                                CollapsibleSection {
                                    title: "Git References — Repository, Issues & Feature Requests";
                                    subtitle: "Direct links to source code, bug report forms, and feature request templates";
                                    expanded: false;

                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 10px;
                                        Text {
                                            text: "GitHub Repository:";
                                            font-weight: 700;
                                            width: 150px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "https://github.com/TheInfoMoose/ST_Rust_Age";
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        RustButton {
                                            variant: "outline-accent";
                                            text: "Open Repo";
                                            tooltip: "Open the Simply Transfer GitHub repository in your default web browser.";
                                            clicked => { root.open_url("https://github.com/TheInfoMoose/ST_Rust_Age"); }
                                        }
                                        RustButton {
                                            variant: "secondary";
                                            text: "Copy URL";
                                            tooltip: "Copy the GitHub repository URL to your clipboard.";
                                            clicked => { root.copy_text("https://github.com/TheInfoMoose/ST_Rust_Age"); }
                                        }
                                    }

                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 10px;
                                        Text {
                                            text: "Bug Report Form:";
                                            font-weight: 700;
                                            width: 150px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "https://github.com/TheInfoMoose/ST_Rust_Age/issues/new?template=bug_report.md";
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        RustButton {
                                            variant: "outline-accent";
                                            text: "Report Bug";
                                            tooltip: "Open the GitHub Bug Report issue form in your browser.";
                                            clicked => { root.open_url("https://github.com/TheInfoMoose/ST_Rust_Age/issues/new?template=bug_report.md"); }
                                        }
                                        RustButton {
                                            variant: "secondary";
                                            text: "Copy URL";
                                            tooltip: "Copy the Bug Report form URL to your clipboard.";
                                            clicked => { root.copy_text("https://github.com/TheInfoMoose/ST_Rust_Age/issues/new?template=bug_report.md"); }
                                        }
                                    }

                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 10px;
                                        Text {
                                            text: "Feature Request Form:";
                                            font-weight: 700;
                                            width: 150px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "https://github.com/TheInfoMoose/ST_Rust_Age/issues/new?template=feature_request.md";
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        RustButton {
                                            variant: "outline-accent";
                                            text: "Request Feature";
                                            tooltip: "Open the GitHub Feature Request form in your browser.";
                                            clicked => { root.open_url("https://github.com/TheInfoMoose/ST_Rust_Age/issues/new?template=feature_request.md"); }
                                        }
                                        RustButton {
                                            variant: "secondary";
                                            text: "Copy URL";
                                            tooltip: "Copy the Feature Request form URL to your clipboard.";
                                            clicked => { root.copy_text("https://github.com/TheInfoMoose/ST_Rust_Age/issues/new?template=feature_request.md"); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // --- Global Floating Styled Tooltip Overlay ---
    if TooltipState.visible && TooltipState.text != "": Rectangle {
        property <length> raw_x: TooltipState.anchor_x + (TooltipState.anchor_w - self.width) / 2;
        property <length> raw_y: (TooltipState.anchor_y + TooltipState.anchor_h + 34px > root.height) ?
            (TooltipState.anchor_y - self.height - 6px) :
            (TooltipState.anchor_y + TooltipState.anchor_h + 6px);

        x: clamp(self.raw_x, 8px, max(8px, root.width - self.width - 8px));
        y: clamp(self.raw_y, 8px, max(8px, root.height - self.height - 8px));
        width: min(root.width - 16px, tt_label.preferred-width + 20px);
        height: tt_label.preferred-height + 12px;
        background: AppTheme.surface_elevated;
        border-width: 1px;
        border-color: AppTheme.accent;
        border-radius: 4px;
        z: 1000;

        tt_label := Text {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            text: TooltipState.text;
            color: Palette.foreground;
            font-size: 11px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}
